diff --git a/README.md b/README.md
new file mode 100644
index 0000000..1a3c861
--- /dev/null
+++ b/README.md
@@ -0,0 +1,17 @@
+# Unofficial OrangeFox Android 16 device tree for diting / ditingp
+
+Base: AviderMin/ofrp_device_xiaomi_diting, commit 1a1b5d3f6c908145e360da990a70b41042929615.
+Ported for the official OrangeFox fox_16.0 source manifest.
+Maintainer: N1-k0-la1. Preserve all upstream file copyright and license notices.
+OrangeFox components are GPL-3.0-or-later; other files retain their original licenses.
+
+Device family: Redmi K50 Ultra (diting) and Xiaomi 12T Pro (ditingp hardware SKU).
+The canonical recovery build target is diting; both OTA aliases are explicitly listed.
+Boot SKU/region are not changed. Unrelated device packages must still be rejected.
+This recovery image excludes a standalone kernel and depends on compatible boot/vendor_boot.
+The first candidate targets the project's Android 16 AviumUI build, not universal MIUI compatibility.
+
+Corrected super/dtbo dimensions; LF-only postinstall fstab; packaged debuggerd dependencies;
+include GKI module search; legacy battery reads; Android 16 KeyMint dependency adaptation.
+The prior fox-logo loop has no captured runtime root cause. Building does not prove it fixed.
+Initial boot, touch, storage decryption, ADB, fastbootd and full OTA installation must be tested.
diff --git a/bootctrl/slots.cpp b/bootctrl/slots.cpp
new file mode 100644
index 0000000..de14632
--- /dev/null
+++ b/bootctrl/slots.cpp
@@ -0,0 +1,21 @@
+// Copyright (C) 2026 N1-k0-la1
+// SPDX-License-Identifier: Apache-2.0
+#include <dlfcn.h>
+#include <sys/stat.h>
+
+// The legacy QTI HAL counts every name beginning with "boot", including the
+// unsuffixed alias generated by Recovery. Only boot_a and boot_b are slots on
+// diting. Keep all slot mutation and snapshot operations in the original HAL.
+extern "C" unsigned diting_get_number_slots() asm("_Z16get_number_slotsv");
+extern "C" unsigned diting_get_number_slots() {
+    struct stat slot_a {}, slot_b {};
+    if (stat("/dev/block/bootdevice/by-name/boot_a", &slot_a) == 0 &&
+        stat("/dev/block/bootdevice/by-name/boot_b", &slot_b) == 0 &&
+        S_ISBLK(slot_a.st_mode) && S_ISBLK(slot_b.st_mode) &&
+        slot_a.st_rdev != slot_b.st_rdev) {
+        return 2;
+    }
+    using Original = unsigned (*)();
+    auto original = reinterpret_cast<Original>(dlsym(RTLD_NEXT, "_Z16get_number_slotsv"));
+    return original ? original() : 0;
+}
