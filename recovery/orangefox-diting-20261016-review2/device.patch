diff --git a/recovery/root/system/bin/diting-adsp-init.sh b/recovery/root/system/bin/diting-adsp-init.sh
new file mode 100755
index 0000000..f8792a1
--- /dev/null
+++ b/recovery/root/system/bin/diting-adsp-init.sh
@@ -0,0 +1,44 @@
+#!/system/bin/sh
+# Copyright (C) 2026 N1-k0-la1
+# SPDX-License-Identifier: GPL-3.0-or-later
+lock_dir=/tmp/diting_adsp_init.lock
+mkdir "$lock_dir" 2>/dev/null || exit 0
+trap 'rmdir "$lock_dir" 2>/dev/null' EXIT
+trap 'exit 0' HUP INT TERM
+find_adsp() {
+    for candidate in /sys/class/remoteproc/remoteproc*; do
+        [ -r "$candidate/name" ] && [ -r "$candidate/state" ] || continue
+        name=$(cat "$candidate/name") || continue
+        if [ "$name" != adsp ]; then
+            # Qualcomm may expose the platform address as the remoteproc name.
+            firmware=$(cat "$candidate/firmware") || continue
+            case "${firmware##*/}" in adsp*.mdt|adsp*.mbn) ;; *) continue ;; esac
+        fi
+        printf '%s\n' "$candidate"
+        return 0
+    done
+    return 1
+}
+attempt=0
+while [ "$attempt" -lt 50 ]; do
+    node=$(find_adsp) && [ -w /sys/kernel/boot_adsp/boot ] && break
+    sleep 0.1
+    attempt=$((attempt + 1))
+done
+[ -n "$node" ] && [ -w /sys/kernel/boot_adsp/boot ] || exit 1
+state=$(cat "$node/state") || exit 1
+if [ "$state" != running ]; then
+    printf '1\n' > /sys/kernel/boot_adsp/boot || exit 1
+fi
+attempt=0
+while [ "$attempt" -lt 100 ]; do
+    state=$(cat "$node/state") || exit 1
+    if [ "$state" = running ] && [ -d /sys/class/power_supply/battery ]; then
+        setprop vendor.recovery.adsp.ready 1
+        exit $?
+    fi
+    sleep 0.1
+    attempt=$((attempt + 1))
+done
+# A failed/unfinished boot must retain its firmware mount for diagnostics/retry.
+exit 1
diff --git a/recovery/root/system/bin/postrecoveryboot.sh b/recovery/root/system/bin/postrecoveryboot.sh
new file mode 100755
index 0000000..a9d2245
--- /dev/null
+++ b/recovery/root/system/bin/postrecoveryboot.sh
@@ -0,0 +1,31 @@
+#!/system/bin/sh
+# Copyright (C) 2026 N1-k0-la1
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Recover a Goodix controller left asleep during recovery startup. This only
+# resets the live controller; it does not update firmware or write partitions.
+# Multiple startup/unblank hooks must not reset the controller concurrently.
+lock_dir=/tmp/diting_goodix_reset.lock
+mkdir "$lock_dir" 2>/dev/null || exit 0
+trap 'rmdir "$lock_dir" 2>/dev/null' EXIT
+trap 'exit 0' HUP INT TERM
+# A queued wake check must not reset a controller after the display went off again.
+if [ "${1:-}" = unblank ]; then
+    read -r brightness < /sys/class/backlight/panel0-backlight/brightness || exit 0
+    case "$brightness" in ''|*[!0-9]*) exit 0 ;; esac
+    [ "$brightness" -gt 0 ] || exit 0
+fi
+for node in /sys/bus/platform/devices/goodix_ts.*; do
+    [ -r "$node/chip_info" ] && [ -w "$node/reset" ] && [ -w "$node/irq_info" ] || continue
+    info=$(cat "$node/chip_info") || continue
+    # Leave a working controller and other touchscreen variants alone.
+    printf '%s\n' "$info" | grep -q '^rom_pid:[[:space:]]*$' || continue
+    echo 'diting: resetting unresponsive Goodix controller at recovery startup'
+    printf '1\n' > "$node/reset" || continue
+    info=$(cat "$node/chip_info") || continue
+    printf '%s\n' "$info" | grep -q '^rom_pid:[[:space:]]*BERLIN[[:space:]]*$' || continue
+    # Only a known disabled IRQ may be enabled; leave enabled/unknown states alone.
+    irq=$(cat "$node/irq_info") || continue
+    printf '%s\n' "$irq" | grep -q '^state:[[:space:]]*disabled[[:space:]]*$' || continue
+    printf '1\n' > "$node/irq_info"
+done
+exit 0
diff --git a/recovery/root/system/bin/postscreenunblank.sh b/recovery/root/system/bin/postscreenunblank.sh
new file mode 100755
index 0000000..58f8505
--- /dev/null
+++ b/recovery/root/system/bin/postscreenunblank.sh
@@ -0,0 +1,10 @@
+#!/system/bin/sh
+# Copyright (C) 2026 N1-k0-la1
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Let the display resume notification settle before checking the controller.
+# Reuse the identity-guarded startup repair after every actual screen unblank.
+(
+    sleep 0.2
+    /system/bin/postrecoveryboot.sh unblank
+) </dev/null >/dev/null 2>&1 &
+exit 0
