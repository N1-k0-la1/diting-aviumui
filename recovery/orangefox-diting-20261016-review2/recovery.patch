new file mode 100644
index 0000000..6e92bf8
--- /dev/null
+++ b/diting_ota_aliases.h
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 N1-k0-la1
+#pragma once
+#include <string>
+
+namespace diting_recovery {
+inline bool HasToken(const std::string& list, char separator, const std::string& value) {
+    if (value.empty()) return false;
+    size_t start = 0;
+    while (start <= list.size()) {
+        size_t end = list.find(separator, start);
+        if (end == std::string::npos) end = list.size();
+        const auto token = list.substr(start, end - start);
+        const auto first = token.find_first_not_of(" \t\r\n\f\v");
+        if (first != std::string::npos) {
+            const auto last = token.find_last_not_of(" \t\r\n\f\v");
+            if (token.substr(first, last - first + 1) == value) return true;
+        }
+        if (end == list.size()) break;
+        start = end + 1;
+    }
+    return false;
+}
+
+// Only this explicitly configured hardware family may use its alternate OTA name.
+// Serial, downgrade, signature and payload checks remain at their original call sites.
+inline bool PackageUsesDitingAlias(const std::string& device, const std::string& package,
+                                  const std::string& configured_devices) {
+    if (device != "diting" && device != "ditingp") return false;
+    if (!HasToken(configured_devices, ',', "diting") ||
+        !HasToken(configured_devices, ',', "ditingp")) return false;
+    return HasToken(package, '|', "diting") || HasToken(package, '|', "ditingp");
+}
+}  // namespace diting_recovery
