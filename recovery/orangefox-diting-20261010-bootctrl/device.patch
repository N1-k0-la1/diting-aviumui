@@ -0,0 +1,8 @@
+#!/system/bin/sh
+# Copyright (C) 2026 N1-k0-la1
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Let the display resume notification settle before checking the controller.
+# Reuse the identity-guarded startup repair after every actual screen unblank.
+sleep 0.2
+/system/bin/postrecoveryboot.sh
+exit 0
