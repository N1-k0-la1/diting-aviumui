 }
 
@@ -789,7 +789,7 @@ bool A2DP_VendorGetLowLatencyStateLhdcV3(const uint8_t* p_codec_info){
   if (a2dp_status != A2DP_SUCCESS) {
     log::error( " : cannot decode codec information: {}",
