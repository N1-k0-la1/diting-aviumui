diff --git a/system/btif/src/btif_a2dp_source.cc b/system/btif/src/btif_a2dp_source.cc
index 728dd3a..deb646f 100644
--- a/system/btif/src/btif_a2dp_source.cc
+++ b/system/btif/src/btif_a2dp_source.cc
@@ -954,28 +954,13 @@ static void btif_a2dp_source_audio_handle_timer(void) {
 /// Callback invoked by the encoder for reading PCM audio data from the
 /// Bluetooth Audio HAL. Runs on the source worker thread.
 static uint32_t btif_a2dp_source_read_callback(uint8_t* p_buf, uint32_t len) {
-  uint32_t bytes_read = 0;
-  uint32_t bytes_offset = 0;
-  uint32_t len_read = len;
-  uint32_t timeout_cnt = 0;
-
-  if (!btif_a2dp_source_cb.sw_audio_is_encoding) {
+  if (!btif_a2dp_source_cb.sw_audio_is_encoding || p_buf == nullptr || len == 0) {
     return 0;
   }
 
-  while (true) {
-    bytes_read = bluetooth::audio::a2dp::read(p_buf + bytes_offset, len_read);
-
-    // Savitech LHDC -- Low Latency Mode
-    bytes_offset += bytes_read;
-    len_read -= bytes_read;
-    timeout_cnt++;
-    if (len_read <= 0 || timeout_cnt >= 5) {
-        bytes_read = bytes_offset;
-        break;
-    }
-    usleep(1000);
-  }
+  // The Audio HAL already handles bounded partial reads and polling.
+  const size_t result = bluetooth::audio::a2dp::read(p_buf, len);
+  const uint32_t bytes_read = result <= len ? static_cast<uint32_t>(result) : len;
   log::verbose("wanted={} read={}", len, bytes_read);
 
   if (bytes_read < len) {
