+    /** Sidebar launches use the same mini-window task and handle as the recents gesture.
+     * Notification and note bubbles keep their TaskView lifecycle and controls.
+     */
+    public void showSidebarApp(String packageName, UserHandle user) {
+        if (!org.rising.view.PopUpViewManager.FEATURE_SUPPORTED) {
+            showOrUpdateAppBubble(packageName, user);
+            return;
+        }
+        mMainExecutor.execute(() -> {
+            if (!isAppBubbleUserAvailable(user)) return;
+            try {
+                Intent intent = mContext.createContextAsUser(user, 0).getPackageManager()
+                        .getLaunchIntentForPackage(packageName);
+                if (intent == null) return;
+                ActivityOptions options = ActivityOptions.makeBasic();
+                options.setLaunchWindowingMode(
+                        android.app.WindowConfiguration.WINDOWING_MODE_MINI_WINDOW_EXT);
+                options.setLaunchDisplayId(mContext.getDisplayId());
+                ActivityManager.RunningTaskInfo task = findSidebarTask(
+                        mTaskOrganizer.getRunningTasks(), packageName,
+                        user.getIdentifier(), mContext.getDisplayId());
+                mBubbleData.setExpanded(false);
+                if (task != null) {
+                    // Resume the current activity stack rather than relaunching its root.
+                    ActivityTaskManager.getService().startActivityFromRecents(
+                            task.taskId, options.toBundle());
+                } else {
+                    // A TaskView-owned bubble must not be reused as a mini-window root.
+                    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK
+                            | Intent.FLAG_ACTIVITY_MULTIPLE_TASK);
+                    mContext.startActivityAsUser(intent, options.toBundle(), user);
+                }
+            } catch (android.content.ActivityNotFoundException | SecurityException
+                    | RemoteException | IllegalArgumentException e) {
+                Log.w(TAG, "Unable to open sidebar mini-window", e);
+            }
+        });
+    }
+
+    @VisibleForTesting
+    static ActivityManager.RunningTaskInfo findSidebarTask(
+            List<ActivityManager.RunningTaskInfo> tasks, String packageName,
+            int userId, int displayId) {
+        ActivityManager.RunningTaskInfo newest = null;
+        for (ActivityManager.RunningTaskInfo task : tasks) {
+            int mode = task.getWindowingMode();
+            if (task.userId != userId || task.displayId != displayId || task.isAppBubble
+                    || task.baseActivity == null
+                    || !packageName.equals(task.baseActivity.getPackageName())
+                    || task.getActivityType()
+                            != android.app.WindowConfiguration.ACTIVITY_TYPE_STANDARD
+                    || (mode != android.app.WindowConfiguration.WINDOWING_MODE_FULLSCREEN
+                            && mode != android.app.WindowConfiguration.WINDOWING_MODE_MINI_WINDOW_EXT
+                            && mode != android.app.WindowConfiguration.WINDOWING_MODE_PINNED_WINDOW_EXT)) {
+                continue;
+            }
+            if (newest == null || task.lastActiveTime > newest.lastActiveTime) newest = task;
+        }
+        return newest;
+    }
+
