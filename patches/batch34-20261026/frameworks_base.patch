+    static void resolvePopUpTaskBounds(Rect bounds, Rect previousBounds, Rect displayBounds,
+            int requestedOrientation, int naturalOrientation) {
+        if (bounds.isEmpty()) {
+            bounds.set(previousBounds.isEmpty() ? displayBounds : previousBounds);
+        }
+        if (bounds.isEmpty()) return;
+        int orientation = requestedOrientation;
+        if (orientation == Configuration.ORIENTATION_UNDEFINED) {
+            // BEHIND/unspecified must retain the app viewport, not follow the host.
+            orientation = previousBounds.isEmpty() ? naturalOrientation
+                    : previousBounds.width() > previousBounds.height()
+                            ? Configuration.ORIENTATION_LANDSCAPE : Configuration.ORIENTATION_PORTRAIT;
+        }
+        int shortEdge = Math.min(bounds.width(), bounds.height());
+        int longEdge = Math.max(bounds.width(), bounds.height());
+        int left = bounds.left;
+        int top = bounds.top;
+        if (orientation == Configuration.ORIENTATION_LANDSCAPE) {
+            bounds.set(left, top, left + longEdge, top + shortEdge);
+        } else {
+            bounds.set(left, top, left + shortEdge, top + longEdge);
+        }
+        WindowResizingAlgorithm.getPopUpViewDefalutBounds(bounds);
+    }
