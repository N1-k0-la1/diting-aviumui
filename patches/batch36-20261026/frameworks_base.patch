+    static ActivityManager.RecentTaskInfo findSidebarRecentTask(
+            List<ActivityManager.RecentTaskInfo> tasks, String packageName,
+            int userId, int displayId) {
+        ActivityManager.RecentTaskInfo newest = null;
+        for (ActivityManager.RecentTaskInfo task : tasks) {
+            final boolean detached = !task.isRunning
+                    && task.displayId == android.view.Display.INVALID_DISPLAY;
+            // RecentTasks restores detached records into the default TaskDisplayArea.
+            if (task.userId != userId || task.isAppBubble
+                    || (detached ? displayId != android.view.Display.DEFAULT_DISPLAY
+                            : task.displayId != displayId)) continue;
+            final int mode = task.getWindowingMode();
+            final int type = task.getActivityType();
+            if (type != android.app.WindowConfiguration.ACTIVITY_TYPE_STANDARD
+                    && !(detached && type
+                            == android.app.WindowConfiguration.ACTIVITY_TYPE_UNDEFINED)) continue;
+            if (mode != android.app.WindowConfiguration.WINDOWING_MODE_FULLSCREEN
+                    && mode != android.app.WindowConfiguration.WINDOWING_MODE_MINI_WINDOW_EXT
+                    && mode != android.app.WindowConfiguration.WINDOWING_MODE_PINNED_WINDOW_EXT
+                    && !(detached && mode
+                            == android.app.WindowConfiguration.WINDOWING_MODE_UNDEFINED)) continue;
+            ComponentName component = task.baseActivity;
+            if (component == null && !task.isRunning) {
+                component = task.realActivity != null ? task.realActivity
+                        : task.baseIntent != null ? task.baseIntent.getComponent() : null;
+            }
+            if (component == null || !packageName.equals(component.getPackageName())) continue;
+            if (newest == null || task.lastActiveTime > newest.lastActiveTime) newest = task;
+        }
+        return newest;
+    }
