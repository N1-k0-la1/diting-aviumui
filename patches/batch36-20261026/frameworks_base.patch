+        // During an IME target handoff, keep the original focused callback rather than guessing.
+        if (imeWindow == null) return true;
+        final Task focusedTask = window.getTask();
+        final Task imeTask = imeWindow.getTask();
+        return focusedTask != null && imeTask != null
+                && focusedTask.getRootTask() != null
+                && focusedTask.getRootTask() == imeTask.getRootTask();
+    }
