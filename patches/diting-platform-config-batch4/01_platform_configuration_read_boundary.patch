diff --git a/private/app_neverallows.te b/private/app_neverallows.te
index 17a9b22..ee7a967 100644
--- a/private/app_neverallows.te
+++ b/private/app_neverallows.te
@@ -21,6 +21,10 @@ neverallow all_untrusted_apps {
   sepolicy_file file_contexts_file hwservice_contexts_file
 }:file { open read map };
 
+# Framework XML and init configuration are not ordinary application inputs.
+neverallow { all_untrusted_apps sdk_sandbox_all }
+  rom_framework_config_file:file { open read map };
+
 # Receive or send uevent messages.
 neverallow all_untrusted_apps domain:netlink_kobject_uevent_socket *;
 
