diff --git a/private/rom_configuration.te b/private/rom_configuration.te
new file mode 100644
index 0000000..7a51e39
--- /dev/null
+++ b/private/rom_configuration.te
@@ -0,0 +1,9 @@
+# Exact platform configuration inputs are consumed by trusted framework loaders.
+# Retain the old system_file reader classes; ordinary app processes and SDK
+# sandboxes receive no content access. No executable or directory is relabeled.
+type rom_framework_config_file, file_type, system_file_type;
+allow {
+  appdomain coredomain
+  -all_untrusted_apps
+  -sdk_sandbox_all
+} rom_framework_config_file:file { getattr open read map };
