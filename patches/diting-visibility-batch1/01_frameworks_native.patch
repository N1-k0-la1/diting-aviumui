@@ -625,7 +626,12 @@ Status ServiceManager::listServices(int32_t dumpPriority, std::vector<std::strin
     for (auto const& [name, service] : mNameToService) {
         (void) service;
 
-        if (service.dumpPriority & dumpPriority) {
+        if (!(service.dumpPriority & dumpPriority)) continue;
+        if (!service.allowIsolated && is_multiuser_uid_isolated(ctx.uid)) continue;
+
+        // Enumeration must not disclose services the caller cannot look up.
+        // Apply the same policy as getService/checkService, without app-name lists.
+        if (mAccess->canFind(ctx, name)) {
             outList->push_back(name);
         }
     }
