+func TestSystemServerConfiguredJarLocations(t *testing.T) {
+	cases := []struct {
+		name, pair, override, expected string
+	}{
+		{"platform unchanged", "platform:library", "", "/system/framework/library.jar"},
+		{"system_ext unchanged", "system_ext:library", "", "/system_ext/framework/library.jar"},
+		{"apex unchanged", "com.android.example:library", "", "/apex/com.android.example/javalib/library.jar"},
+		{"platform renamed", "platform:library", "platform:library:platform:renamed", "/system/framework/renamed.jar"},
+		{"system_ext renamed", "system_ext:library", "system_ext:library:system_ext:renamed", "/system_ext/framework/renamed.jar"},
+		{"apex renamed", "com.android.example:library", "com.android.example:library:com.android.example:renamed", "/apex/com.android.example/javalib/renamed.jar"},
+		{"platform to system_ext", "platform:library", "platform:library:system_ext:renamed", "/system_ext/framework/renamed.jar"},
+		{"system_ext to platform", "system_ext:library", "system_ext:library:platform:renamed", "/system/framework/renamed.jar"},
+		{"platform to apex", "platform:library", "platform:library:com.android.example:renamed", "/apex/com.android.example/javalib/renamed.jar"},
+		{"different owner", "platform:library", "com.android.example:library:platform:renamed", "/system/framework/library.jar"},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			config := android.TestConfig("out", nil, "", nil)
+			if test.override != "" {
+				config.TestProductVariables.ConfiguredJarLocationOverrides = []string{test.override}
+			}
+			ctx := android.BuilderContextForTesting(config)
+			global := GlobalConfigForTests(ctx)
+			jars := android.CreateTestConfiguredJarList([]string{test.pair})
+			if strings.HasPrefix(test.pair, "com.android.") {
+				global.ApexSystemServerJars = jars
+			} else {
+				global.SystemServerJars = jars
+			}
+			android.AssertStringEquals(t, "dex location", test.expected,
+				GetSystemServerDexLocation(ctx, global, "library"))
+			android.AssertStringEquals(t, "same location as runtime classpath", test.expected,
+				jars.DevicePaths(config, android.Android)[0])
+		})
+	}
+}
+
+func TestDexPreoptRenamedSystemServerJarContext(t *testing.T) {
+	previous := DexpreoptRunningInSoong
+	DexpreoptRunningInSoong = true
+	t.Cleanup(func() { DexpreoptRunningInSoong = previous })
+	config := android.TestConfig("out", nil, "", nil)
+	config.TestProductVariables.ConfiguredJarLocationOverrides = []string{
+		"platform:library:platform:renamed",
+	}
+	ctx := android.BuilderContextForTesting(config)
+	global := GlobalConfigForTests(ctx)
+	global.SystemServerJars = android.CreateTestConfiguredJarList([]string{
+		"platform:library", "platform:following",
+	})
+	module := testPlatformSystemServerModuleConfig(ctx, "following")
+	rule, err := GenerateDexpreoptRule(ctx, globalSoongConfigForTests(ctx), global,
+		module, android.PathForTesting("product_packages.txt"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	commands := strings.Join(rule.Commands(), " ")
+	android.AssertStringDoesContain(t, "renamed preceding JAR in device classloader context", commands,
+		`stored_class_loader_context_arg=--stored-class-loader-context="PCL[/system/framework/renamed.jar]"`)
+	if strings.Contains(commands, "/system/framework/library.jar") {
+		t.Fatal("dexpreopt still stores the obsolete device path")
+	}
+}
