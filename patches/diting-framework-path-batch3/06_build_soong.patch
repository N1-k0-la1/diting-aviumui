diff --git a/dexpreopt/dexpreopt.go b/dexpreopt/dexpreopt.go
index bd5d65a..932cbc0 100644
--- a/dexpreopt/dexpreopt.go
+++ b/dexpreopt/dexpreopt.go
@@ -209,31 +209,42 @@ func bootProfileCommand(ctx android.PathContext, globalSoong *GlobalSoongConfig,
 	return profilePath
 }
 
-// Returns the dex location of a system server java library.
-func GetSystemServerDexLocation(ctx android.PathContext, global *GlobalConfig, lib string) string {
-	if apex := global.AllApexSystemServerJars(ctx).ApexOfJar(lib); apex != "" {
-		return fmt.Sprintf("/apex/%s/javalib/%s.jar", apex, lib)
+// Resolve the same configured location used by the generated classpath.
+func systemServerJarLocation(ctx android.PathContext, global *GlobalConfig, lib string) (string, string) {
+	apex := global.AllApexSystemServerJars(ctx).ApexOfJar(lib)
+	if apex == "" {
+		apex = global.AllPlatformSystemServerJars(ctx).ApexOfJar(lib)
 	}
-
-	if apex := global.AllPlatformSystemServerJars(ctx).ApexOfJar(lib); apex == "system_ext" {
-		return fmt.Sprintf("/system_ext/framework/%s.jar", lib)
+	if apex == "" {
+		apex = "platform"
 	}
+	return android.OverrideConfiguredJarLocationFor(ctx.Config(), apex, lib)
+}
 
-	return fmt.Sprintf("/system/framework/%s.jar", lib)
+// Returns the dex location of a system server java library.
+func GetSystemServerDexLocation(ctx android.PathContext, global *GlobalConfig, lib string) string {
+	apex, jar := systemServerJarLocation(ctx, global, lib)
+	switch apex {
+	case "platform":
+		return fmt.Sprintf("/system/framework/%s.jar", jar)
+	case "system_ext":
+		return fmt.Sprintf("/system_ext/framework/%s.jar", jar)
+	default:
+		return fmt.Sprintf("/apex/%s/javalib/%s.jar", apex, jar)
+	}
 }
 
 // Returns the dex install location of a system server java library.
 func GetSystemServerDexInstallLocation(ctx android.ModuleContext, lib string) string {
-	global := GetGlobalConfig(ctx)
-	if apex := global.AllApexSystemServerJars(ctx).ApexOfJar(lib); apex != "" {
-		return fmt.Sprintf("/apex/%s/javalib/%s.jar", apex, lib)
-	}
-
-	if apex := global.AllPlatformSystemServerJars(ctx).ApexOfJar(lib); apex == "system_ext" {
-		return fmt.Sprintf("/%s/framework/%s.jar", ctx.DeviceConfig().SystemExtPath(), lib)
+	apex, jar := systemServerJarLocation(ctx, GetGlobalConfig(ctx), lib)
+	switch apex {
+	case "platform":
+		return fmt.Sprintf("/system/framework/%s.jar", jar)
+	case "system_ext":
+		return fmt.Sprintf("/%s/framework/%s.jar", ctx.DeviceConfig().SystemExtPath(), jar)
+	default:
+		return fmt.Sprintf("/apex/%s/javalib/%s.jar", apex, jar)
 	}
-
-	return fmt.Sprintf("/system/framework/%s.jar", lib)
 }
 
