+        final int callingUid = Binder.getCallingUid();
+        final PackageInfo info = getPackageInfoInternal(packageName,
+                PackageManager.VERSION_CODE_HIGHEST, flags, callingUid, userId);
+        if (info != null) return info;
+        return getCloneCallerSigningInfo(packageName, flags, callingUid, userId);
+    }
+
+    /**
+     * A clone may verify the real parent-space caller of an activity-for-result without
+     * installing another copy of that caller. Return authentic signing metadata only;
+     * this does not resolve activities, enumerate parent apps or grant access to their data.
+     */
+    private PackageInfo getCloneCallerSigningInfo(String packageName, long flags,
+            int callingUid, int userId) {
+        final long signingFlags = PackageManager.GET_SIGNATURES
+                | (long) PackageManager.GET_SIGNING_CERTIFICATES;
+        if ((flags & signingFlags) == 0 || (flags & ~signingFlags) != 0
+                || userId != UserHandle.getUserId(callingUid)
+                || UserHandle.getAppId(callingUid) < Process.FIRST_APPLICATION_UID
+                || Process.isIsolated(callingUid) || Process.isSdkSandboxUid(callingUid)
+                || getInstantAppPackageName(callingUid) != null) return null;
+        final UserManagerInternal users = mInjector.getUserManagerInternal();
+        final UserInfo clone = users.getUserInfo(userId);
+        if (clone == null || !clone.isCloneProfile() || !clone.isEnabled()
+                || clone.isQuietModeEnabled() || !users.isUserUnlocked(userId)) return null;
+        final int parentId = users.getProfileParentId(userId);
+        final UserInfo parent = users.getUserInfo(parentId);
+        if (parent == null || parentId == userId || !parent.isEnabled()
+                || parent.isProfile() || !users.isUserUnlocked(parentId)
+                || GmsManagerService.shouldHide(parentId, packageName)) return null;
+        final PackageStateInternal ps = mSettings.getPackage(packageName);
+        if (ps == null || ps.getPkg() == null
+                // Preserve explicit clone-local installs (including hidden/disabled ones).
+                || ps.getUserStateOrDefault(userId).isInstalled()) return null;
+        final PackageUserStateInternal state = ps.getUserStateOrDefault(parentId);
+        if (!state.isInstalled() || state.isHidden() || state.isSuspended()
+                || state.isInstantApp() || PackageArchiver.isArchived(state)
+                || (state.getEnabledState() != PackageManager.COMPONENT_ENABLED_STATE_DEFAULT
+                && state.getEnabledState() != PackageManager.COMPONENT_ENABLED_STATE_ENABLED)
+                || !mAppsFilter.isImplicitlyQueryable(callingUid,
+                        UserHandle.getUid(parentId, ps.getAppId()))) return null;
+        // Internal body retains ordinary visibility filtering and the real parent UID/signers.
+        // Cross-user permission checks above still apply to every explicit other-user query.
+        return getPackageInfoInternalBody(packageName, PackageManager.VERSION_CODE_HIGHEST,
+                flags, callingUid, parentId);
     }
 
