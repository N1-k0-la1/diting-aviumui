+  LHDC_OUTPUT_LEFT_CAHNNEL,
+  LHDC_OUTPUT_RIGHT_CAHNNEL,
+} lhdc_channel_t;
+
+typedef enum{
+  LHDC_DEC_LOG_LEVEL_EMERG = 0,
+  LHDC_DEC_LOG_LEVEL_ALERT,
+  LHDC_DEC_LOG_LEVEL_CRIT,
+  LHDC_DEC_LOG_LEVEL_ERROR,
+  LHDC_DEC_LOG_LEVEL_WARNING,
