+// SPDX-License-Identifier: Apache-2.0
+// Integration of Savitech headers and Xiaomi mondrian prebuilts from The XPerience Project.
+cc_library_headers {
+    name: "diting-lhdc-headers",
+    host_supported: true,
+    export_include_dirs: ["inc", "include"],
+    apex_available: ["//apex_available:platform", "com.android.bt"],
+    min_sdk_version: "33",
+}
+
+cc_prebuilt_library_shared {
+    name: "liblhdc",
+    owner: "savitech",
+    arch: {
+        arm: { srcs: ["libs/armeabi-v7a/liblhdc.so"] },
+        arm64: { srcs: ["libs/arm64-v8a/liblhdc.so"] },
+    },
+    shared_libs: ["liblog", "libstdc++"],
+    apex_available: ["//apex_available:platform", "com.android.bt"],
+    min_sdk_version: "33",
+    stl: "none",
+    strip: { none: true },
+    prefer: true,
+}
+
+cc_prebuilt_library_shared {
+    name: "liblhdcv5",
+    owner: "savitech",
+    arch: {
+        arm: { srcs: ["libs/armeabi-v7a/liblhdcv5.so"] },
+        arm64: { srcs: ["libs/arm64-v8a/liblhdcv5.so"] },
+    },
+    shared_libs: ["liblog", "libstdc++"],
+    apex_available: ["//apex_available:platform", "com.android.bt"],
+    min_sdk_version: "33",
+    stl: "none",
+    strip: { none: true },
+    prefer: true,
+}
+
+cc_prebuilt_library_shared {
+    name: "liblhdcBT_enc",
+    owner: "savitech",
+    arch: {
+        arm: { srcs: ["libs/armeabi-v7a/liblhdcBT_enc.so"] },
+        arm64: { srcs: ["libs/arm64-v8a/liblhdcBT_enc.so"] },
+    },
+    shared_libs: ["libcutils", "liblog", "liblhdc", "libc++"],
+    apex_available: ["//apex_available:platform", "com.android.bt"],
+    min_sdk_version: "33",
+    stl: "none",
+    strip: { none: true },
+    prefer: true,
+}
+
+cc_prebuilt_library_shared {
+    name: "liblhdcv5BT_enc",
+    owner: "savitech",
+    arch: {
+        arm: { srcs: ["libs/armeabi-v7a/liblhdcv5BT_enc.so"] },
+        arm64: { srcs: ["libs/arm64-v8a/liblhdcv5BT_enc.so"] },
+    },
+    shared_libs: ["libcutils", "liblog", "liblhdcv5", "libc++"],
+    apex_available: ["//apex_available:platform", "com.android.bt"],
+    min_sdk_version: "33",
+    stl: "none",
+    strip: { none: true },
+    prefer: true,
+}
+
+// Explicitly built test tool; not included in PRODUCT_PACKAGES or shipped in ROM.
+cc_binary {
+    name: "diting_lhdc_encoder_probe",
+    srcs: ["lhdc_encoder_probe.cc"],
+    shared_libs: ["libdl"],
+    stl: "none",
+    compile_multilib: "64",
+    cflags: ["-Wall", "-Werror"],
+}
