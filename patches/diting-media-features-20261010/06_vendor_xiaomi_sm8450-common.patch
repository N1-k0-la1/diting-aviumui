+  LHDCV5_FRET_ERROR                     =   -10,
+  LHDCV5_FRET_BUF_NOT_ENOUGH            =   -11,
+} LHDCV5_FUNC_RET_T;
+
+typedef struct _lhdcv5_abr_para_t 
+{
+  uint32_t  version;            // version of LHDC 5.0 CODEC
+  uint32_t  sample_rate;        // sample rate (Hz)
