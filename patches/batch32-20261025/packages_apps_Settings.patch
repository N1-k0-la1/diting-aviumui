+/*
+ * Copyright (C) 2026 The AviumUI Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.wifi;
+
+import android.content.Context;
+import android.net.wifi.WifiManager;
+import android.os.UserManager;
+import android.util.Log;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/** Uses the Wi-Fi service's existing persisted mode, with no duplicate settings value. */
+public class DualBandWifiPreferenceController extends TogglePreferenceController {
+    private static final String TAG = "DualBandWifiPreference";
+    private final WifiManager mWifiManager;
+    private final UserManager mUserManager;
+
+    public DualBandWifiPreferenceController(Context context, String key) {
+        super(context, key);
+        mWifiManager = context.getSystemService(WifiManager.class);
+        mUserManager = context.getSystemService(UserManager.class);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        if (!mContext.getResources().getBoolean(R.bool.config_show_wifi_dual_band)
+                || mWifiManager == null || mUserManager == null) {
+            return UNSUPPORTED_ON_DEVICE;
+        }
+        if (!mUserManager.isAdminUser()
+                || mUserManager.hasUserRestriction(UserManager.DISALLOW_CONFIG_WIFI)) {
+            return DISABLED_FOR_USER;
+        }
+        try {
+            return mWifiManager.isStaConcurrencyForMultiInternetSupported()
+                    ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+        } catch (RuntimeException exception) {
+            Log.w(TAG, "Cannot query dual-band support", exception);
+            return UNSUPPORTED_ON_DEVICE;
+        }
+    }
+
+    @Override
+    public boolean isChecked() {
+        if (mWifiManager == null) return false;
+        try {
+            return mWifiManager.getStaConcurrencyForMultiInternetMode()
+                    == WifiManager.WIFI_MULTI_INTERNET_MODE_DBS_AP;
+        } catch (RuntimeException exception) {
+            Log.w(TAG, "Cannot read dual-band mode", exception);
+            return false;
+        }
+    }
+
+    @Override
+    public boolean setChecked(boolean checked) {
+        if (getAvailabilityStatus() != AVAILABLE) return false;
+        try {
+            return mWifiManager.setStaConcurrencyForMultiInternetMode(checked
+                    ? WifiManager.WIFI_MULTI_INTERNET_MODE_DBS_AP
+                    : WifiManager.WIFI_MULTI_INTERNET_MODE_DISABLED);
+        } catch (RuntimeException exception) {
+            Log.w(TAG, "Cannot change dual-band mode", exception);
+            return false;
+        }
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_network;
+    }
+}
