diff --git a/PrepareSubdirsError.h b/PrepareSubdirsError.h
new file mode 100644
index 0000000..1f3ea9a
--- /dev/null
+++ b/PrepareSubdirsError.h
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+// Private exit-code protocol between vold and vold_prepare_subdirs. These fixed identifiers
+// contain no paths, credentials or policy key references. Unknown/legacy exit codes stay failures.
+enum class PrepareSubdirsError : int {
+    kUnknown = 1,
+    kContext = 32,
+    kUserDe = 33,
+    kSdkSandboxDe = 34,
+    kVoldDe = 35,
+    kStoragedDe = 36,
+    kRollbackDe = 37,
+    kProfilesDe = 38,
+    kFingerprintDe = 39,
+    kFaceDe = 40,
+    kUserCe = 41,
+    kSdkSandboxCe = 42,
+    kVoldCe = 43,
+    kStoragedCe = 44,
+    kRollbackCe = 45,
+    kCheckinCe = 46,
+    kBackupCe = 47,
+    kBackupStageCe = 48,
+    kAppSearchCe = 49,
+    kFaceCe = 50,
+};
+
+inline const char* PrepareSubdirsErrorName(int status) {
+    switch (static_cast<PrepareSubdirsError>(status)) {
+        case PrepareSubdirsError::kContext: return "selinux-contexts";
+        case PrepareSubdirsError::kUserDe: return "user-de";
+        case PrepareSubdirsError::kSdkSandboxDe: return "sdk-sandbox-de";
+        case PrepareSubdirsError::kVoldDe: return "vold-de";
+        case PrepareSubdirsError::kStoragedDe: return "storaged-de";
+        case PrepareSubdirsError::kRollbackDe: return "rollback-de";
+        case PrepareSubdirsError::kProfilesDe: return "profiles-de";
+        case PrepareSubdirsError::kFingerprintDe: return "fingerprint-de";
+        case PrepareSubdirsError::kFaceDe: return "face-de";
+        case PrepareSubdirsError::kUserCe: return "user-ce";
+        case PrepareSubdirsError::kSdkSandboxCe: return "sdk-sandbox-ce";
+        case PrepareSubdirsError::kVoldCe: return "vold-ce";
+        case PrepareSubdirsError::kStoragedCe: return "storaged-ce";
+        case PrepareSubdirsError::kRollbackCe: return "rollback-ce";
+        case PrepareSubdirsError::kCheckinCe: return "checkin-ce";
+        case PrepareSubdirsError::kBackupCe: return "backup-ce";
+        case PrepareSubdirsError::kBackupStageCe: return "backup-stage-ce";
+        case PrepareSubdirsError::kAppSearchCe: return "appsearch-ce";
+        case PrepareSubdirsError::kFaceCe: return "face-ce";
+        default: return "unknown";
+    }
+}
