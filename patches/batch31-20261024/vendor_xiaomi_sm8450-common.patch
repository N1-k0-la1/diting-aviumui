--- /dev/null
+++ b/dolby-vision/service.cpp
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: Apache-2.0
+// Construct the platform HIDL wrapper locally; retain the vendor codec store.
+#define LOG_TAG "dolbycodec2"
+
+#include <csignal>
+#include <cstdlib>
+#include <memory>
+
+#include <binder/ProcessState.h>
+#include <codec2/hidl/1.0/ComponentStore.h>
+#include <hidl/HidlTransportSupport.h>
+#include <log/log.h>
+
+namespace android {
+std::shared_ptr<C2ComponentStore> GetCodec2DolbyComponentStore();
+}
+
+int main() {
+    using namespace android;
+    using HidlComponentStore = hardware::media::c2::V1_0::utils::ComponentStore;
+
+    std::signal(SIGPIPE, SIG_IGN);
+    ProcessState::initWithDriver("/dev/vndbinder");
+    ProcessState::self()->startThreadPool();
+    hardware::configureRpcThreadpool(8, true /* callerWillJoin */);
+
+    auto codecStore = GetCodec2DolbyComponentStore();
+    if (!codecStore) {
+        ALOGE("Cannot create Dolby Codec2 store");
+        return EXIT_FAILURE;
+    }
+    // sizeof/virtual-base offsets must match this build's libcodec2_hidl@1.0.
+    auto service = sp<HidlComponentStore>::make(codecStore);
+    if (service->status() != C2_OK) {
+        ALOGE("Cannot initialize Dolby HIDL store: %d", service->status());
+        return EXIT_FAILURE;
+    }
+    const status_t result = service->registerAsService("dolby");
+    if (result != OK) {
+        ALOGE("Cannot register Dolby HIDL store: %d", result);
+        return EXIT_FAILURE;
+    }
+    ALOGI("Dolby Codec2 store registered");
+    hardware::joinRpcThreadpool();
+    return EXIT_FAILURE;  // A service thread pool must not return normally.
+}
