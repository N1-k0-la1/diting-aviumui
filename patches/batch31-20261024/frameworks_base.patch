+        final boolean portrait;
+        if (taskInfo.appCompatTaskInfo.isTopActivityLetterboxed()
+                && !appBounds.isEmpty() && appBounds.width() != appBounds.height()) {
+            // ActivityInfo contains the manifest orientation, not a runtime request.
+            // A BEHIND/unspecified activity can request portrait after launch (or
+            // landscape for video). WM's letterboxed app bounds describe that request.
+            portrait = appBounds.width() < appBounds.height();
+        } else {
+            if (!isFixedOrientationPortrait(orientation)
+                    && !isFixedOrientationLandscape(orientation)) {
+                // No runtime letterbox evidence: retain the last stable shape for
+                // splash/redirect pages and after the task has been resized to fit.
+                return;
+            }
+            // A fixed-portrait manifest may still switch to a landscape video at runtime.
+            portrait = isFixedOrientationPortrait(orientation)
+                    && (appBounds.isEmpty() || appBounds.width() <= appBounds.height());
         }
