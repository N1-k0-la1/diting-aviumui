From 930e6f73f237a02005667e9dc7c453d1d9313bc9 Mon Sep 17 00:00:00 2001
From: Local ROM Builder <rombuilder@localhost>
Date: Wed, 7 Oct 2026 22:02:08 +0800
Subject: [PATCH] Use actual Android 12 KMI 9 release naming for diting kernel
 and modules

---
 Makefile                                    | 5 +++++
 arch/arm64/configs/vendor/diting_GKI.config | 3 +++
 2 files changed, 8 insertions(+)

diff --git a/Makefile b/Makefile
index ac6ebd447..234aae0ec 100644
--- a/Makefile
+++ b/Makefile
@@ -3,6 +3,11 @@ VERSION = 5
 PATCHLEVEL = 10
 SUBLEVEL = 269
 EXTRAVERSION =
+
+# Keep Android release and KMI naming consistent for in-tree and external modules.
+# These defaults match build.config.common; explicit caller values still win.
+BRANCH ?= android12-5.10
+KMI_GENERATION ?= 9
 NAME = Dare mighty things
 
 # indicate that change "Kbuild: Support nested composite objects" is
diff --git a/arch/arm64/configs/vendor/diting_GKI.config b/arch/arm64/configs/vendor/diting_GKI.config
index fa1669a00..6d98c753f 100644
--- a/arch/arm64/configs/vendor/diting_GKI.config
+++ b/arch/arm64/configs/vendor/diting_GKI.config
@@ -8,3 +8,6 @@
 CONFIG_BQ_FG_UPDATE=y
 CONFIG_MI_CHARGER_M81=y
 CONFIG_MI_THERMAL_MULTI_CHARGE=y
+
+# The Android release / KMI / actual SCM suffix is generated by setlocalversion.
+CONFIG_LOCALVERSION=""
-- 
2.34.1

