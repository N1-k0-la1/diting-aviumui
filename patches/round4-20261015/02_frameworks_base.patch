index 0000000000000000000000000000000000000000..610e5552151f7665389c7b6d676de73b5a2a560d
--- /dev/null
+++ b/services/core/java/com/android/server/graphics/fonts/GlobalFontConfig.java
@@ -0,0 +1,83 @@
+/* Copyright (C) 2026 diting AviumUI contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.graphics.fonts;
+
+import android.text.FontConfig;
+import android.graphics.Typeface;
+
+import org.json.JSONObject;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Applies the boot-selected font to system-wide text families, retaining stock fallbacks. */
+final class GlobalFontConfig {
+    private GlobalFontConfig() {}
+
+    static String selectedFamily(String theme) {
+        if (theme == null || theme.isEmpty()) return null;
+        try {
+            switch (new JSONObject(theme).optString("android.theme.customization.font")) {
+                case "com.android.theme.font.custom": return UserCustomFontStore.FAMILY;
+                case "com.android.theme.font.condensed": return "sans-serif-condensed";
+                case "com.android.theme.font.sourcesanspro": return "source-sans-pro";
+                case "com.android.theme.font.notoserif": return "serif";
+                default: return null;
+            }
+        } catch (Exception e) {
+            // Malformed or unknown settings must never prevent system font initialization.
+            return null;
+        }
+    }
+
+    static Map<String, Typeface> apply(Map<String, Typeface> base, String selectedFamily,
+            List<FontConfig.Alias> aliases) {
+        if (selectedFamily == null) return base;
+        if (UserCustomFontStore.FAMILY.equals(selectedFamily)) {
+            for (FontConfig.Alias alias : aliases) {
+                // The store publishes an alias only when no imported font loaded.
+                // Do not turn that recovery alias into a new device-wide selection.
+                if (UserCustomFontStore.FAMILY.equals(alias.getName())) return base;
+            }
+        }
+        Typeface selected = base.get(selectedFamily);
+        if (selected == null) return base;
+        Map<String, Typeface> result = new HashMap<>(base);
+        Set<String> changed = new HashSet<>();
+        for (String name : base.keySet()) {
+            if (!name.equals(selectedFamily) && isTextFamily(name)) changed.add(name);
+        }
+        // Cover aliases such as arial/helvetica too, without replacing code/icon fonts.
+        boolean added;
+        do {
+            added = false;
+            for (FontConfig.Alias alias : aliases) {
+                if (changed.contains(alias.getOriginal()) && base.containsKey(alias.getName())
+                        && !alias.getName().equals(selectedFamily)) {
+                    added |= changed.add(alias.getName());
+                }
+            }
+        } while (added);
+        for (String name : changed) {
+            Typeface original = base.get(name);
+            // Settings can still preview the stock/default option while the global
+            // selection is active. These aliases do not change normal app lookups.
+            result.putIfAbsent("diting-stock-" + name, original);
+            // Reuse the selected native collection in full: retaining just its named
+            // fonts would lose language-specific CJK fallbacks (notably serif).
+            result.put(name, Typeface.create(selected, original.getWeight(), original.isItalic()));
+        }
+        return result;
+    }
+
+    private static boolean isTextFamily(String name) {
+        return name.equals("sans-serif") || name.startsWith("sans-serif-")
+                || name.equals("serif") || name.equals("system-ui")
+                || name.equals("source-sans-pro") || name.startsWith("source-sans-pro-")
+                || name.equals("google-sans") || name.startsWith("google-sans-");
+    }
+}
