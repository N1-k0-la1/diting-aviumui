diff --git a/audio-policy-probe/Android.bp b/audio-policy-probe/Android.bp
new file mode 100644
index 0000000000000000000000000000000000000000..210bf650cd108b55adab3f0991a62e672dde33f5
--- /dev/null
+++ b/audio-policy-probe/Android.bp
@@ -0,0 +1,10 @@
+// Test-only executable: not listed in PRODUCT_PACKAGES.
+cc_binary {
+    name: "diting_lhdc_policy_probe",
+    srcs: ["policy_probe.cpp"],
+    defaults: ["latest_android_media_audio_common_types_cpp_shared"],
+    static_libs: ["libaudiopolicycomponents"],
+    shared_libs: ["libaudiofoundation", "libaudiopolicy", "libmedia", "libmedia_helper",
+                  "libutils", "liblog", "libbase", "libxml2"],
+    cflags: ["-Wall", "-Werror"],
+}
diff --git a/audio-policy-probe/policy_probe.cpp b/audio-policy-probe/policy_probe.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9b9e706de0585b212b341edaa34fe74defd87bd3
--- /dev/null
+++ b/audio-policy-probe/policy_probe.cpp
@@ -0,0 +1,47 @@
+#include <AudioPolicyConfig.h>
+#include <IOProfile.h>
+#include <cstdio>
+#include <cstring>
+
+int main(int argc, char** argv) {
+    if (argc != 3) return 2;
+    const auto result = android::AudioPolicyConfig::loadFromCustomXmlConfigForTests(argv[1]);
+    if (!result.ok()) { std::puts("PARSE_FAILED"); return 3; }
+    const auto& modules = result.value()->getHwModules();
+    std::printf("parsed_modules=%zu\n", modules.size());
+    audio_module_handle_t nextHandle = 1;
+    for (const auto& module : modules) {
+        module->setHandle(nextHandle++);
+        std::printf("parsed_module=%s profiles=%zu devices=%zu\n", module->getName(),
+            module->getOutputProfiles().size(), module->getDeclaredDevices().size());
+        for (const auto& profile : module->getOutputProfiles()) {
+            std::printf("profile=%s supported=%zu\n", profile->getName().c_str(),
+                profile->getSupportedDevices().size());
+        }
+    }
+    const audio_devices_t types[] = {AUDIO_DEVICE_OUT_BLUETOOTH_A2DP,
+        AUDIO_DEVICE_OUT_BLUETOOTH_A2DP_HEADPHONES, AUDIO_DEVICE_OUT_BLUETOOTH_A2DP_SPEAKER};
+    const audio_format_t formats[] = {AUDIO_FORMAT_SBC, AUDIO_FORMAT_AAC, AUDIO_FORMAT_APTX,
+        AUDIO_FORMAT_APTX_HD, AUDIO_FORMAT_LDAC, AUDIO_FORMAT_LHDC};
+    int failures = 0;
+    for (const auto type : types) {
+        for (const auto format : formats) {
+            // Match AudioPolicyManager's connection entry: choose a declared device
+            // by encoded format, then attach it and establish its current encoding.
+            const auto descriptor = modules.getDeviceDescriptor(type, "", "policy-test", format, true);
+            const auto module = descriptor ? modules.getModuleFromHandle(descriptor->getModuleHandle()) : nullptr;
+            const char* actual = module ? module->getName() : "none";
+            const char* expected = format == AUDIO_FORMAT_LHDC ? argv[2] : "primary";
+            const bool ok = std::strcmp(actual, expected) == 0;
+            std::printf("device=%#x format=%#x module=%s expected=%s %s\n",
+                type, format, actual, expected, ok ? "PASS" : "FAIL");
+            failures += !ok;
+        }
+    }
+    const auto speakerDescriptor = modules.getDeviceDescriptor(AUDIO_DEVICE_OUT_SPEAKER, "", "speaker-test",
+        AUDIO_FORMAT_DEFAULT, true);
+    const auto speaker = speakerDescriptor ? modules.getModuleFromHandle(speakerDescriptor->getModuleHandle()) : nullptr;
+    if (!speaker || std::strcmp(speaker->getName(), "primary") != 0) ++failures;
+    std::printf("speaker_primary=%s\n", failures == 0 ? "PASS" : "FAIL");
+    return failures == 0 ? 0 : 1;
+}
diff --git a/audio/bluetooth_lhdc_audio_policy_configuration.xml b/audio/bluetooth_lhdc_audio_policy_configuration.xml
new file mode 100644
index 0000000000000000000000000000000000000000..288d4f9a2b50d148ec2fc07cd6c6876c6dde87f9
--- /dev/null
+++ b/audio/bluetooth_lhdc_audio_policy_configuration.xml
@@ -0,0 +1,35 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- LHDC uses the existing AOSP Bluetooth software HAL, not Qualcomm DSP offload. -->
+<module name="bluetooth" halVersion="2.0">
+    <mixPorts>
+        <mixPort name="a2dp output" role="source"/>
+    </mixPorts>
+    <devicePorts>
+        <devicePort tagName="BT A2DP Out" type="AUDIO_DEVICE_OUT_BLUETOOTH_A2DP"
+                    role="sink" encodedFormats="AUDIO_FORMAT_LHDC">
+            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
+                     samplingRates="44100 48000 96000 192000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
+            <profile name="" format="AUDIO_FORMAT_PCM_24_BIT_PACKED"
+                     samplingRates="44100 48000 96000 192000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
+        </devicePort>
+        <devicePort tagName="BT A2DP Headphones" type="AUDIO_DEVICE_OUT_BLUETOOTH_A2DP_HEADPHONES"
+                    role="sink" encodedFormats="AUDIO_FORMAT_LHDC">
+            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
+                     samplingRates="44100 48000 96000 192000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
+            <profile name="" format="AUDIO_FORMAT_PCM_24_BIT_PACKED"
+                     samplingRates="44100 48000 96000 192000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
+        </devicePort>
+        <devicePort tagName="BT A2DP Speaker" type="AUDIO_DEVICE_OUT_BLUETOOTH_A2DP_SPEAKER"
+                    role="sink" encodedFormats="AUDIO_FORMAT_LHDC">
+            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
+                     samplingRates="44100 48000 96000 192000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
+            <profile name="" format="AUDIO_FORMAT_PCM_24_BIT_PACKED"
+                     samplingRates="44100 48000 96000 192000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
+        </devicePort>
+    </devicePorts>
+    <routes>
+        <route type="mix" sink="BT A2DP Out" sources="a2dp output"/>
+        <route type="mix" sink="BT A2DP Headphones" sources="a2dp output"/>
+        <route type="mix" sink="BT A2DP Speaker" sources="a2dp output"/>
+    </routes>
+</module>
