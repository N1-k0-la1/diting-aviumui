diff --git a/services/core/java/com/android/server/graphics/fonts/UserCustomFontStore.java b/services/core/java/com/android/server/graphics/fonts/UserCustomFontStore.java
new file mode 100644
index 0000000000000000000000000000000000000000..425e3549575d25bd598064b3dd979979ab295173
--- /dev/null
+++ b/services/core/java/com/android/server/graphics/fonts/UserCustomFontStore.java
@@ -0,0 +1,276 @@
+/* Copyright (C) 2026 diting AviumUI contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.graphics.fonts;
+
+import android.content.res.Resources;
+import android.graphics.fonts.FontStyle;
+import android.os.Bundle;
+import android.os.LocaleList;
+import android.os.ParcelFileDescriptor;
+import android.system.Os;
+import android.system.OsConstants;
+import android.text.FontConfig;
+import android.util.AtomicFile;
+import android.util.Slog;
+
+import com.android.internal.graphics.fonts.CustomFontFileValidator;
+import com.android.internal.security.VerityUtils;
+
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/** Separate manual-import slot; never changes the signed-provider font update trust rules. */
+final class UserCustomFontStore {
+    private static final String TAG = "UserCustomFontStore";
+    static final String FAMILY = "diting-user-custom";
+    // Keep manual imports outside UpdatableFontDir's exclusively managed tree.
+    private final File mDirectory = new File("/data/fonts/user-custom");
+    private final AtomicFile mMetadata = new AtomicFile(new File("/data/fonts/config/user-custom.json"));
+    private final AtomicFile mBootMarker = new AtomicFile(new File("/data/fonts/config/user-custom-boot.json"));
+    private JSONObject mImported;
+    private JSONObject mLoaded;
+    private boolean mRejectedAtBoot;
+    private final boolean mSafeMode;
+
+    UserCustomFontStore(boolean safeMode) {
+        mSafeMode = safeMode;
+        mImported = readMetadata();
+        if (safeMode || mImported == null) return;
+        // A previous incomplete boot must not retry a font that may have caused it.
+        // Conservatively quarantine on any incomplete boot, even a power interruption.
+        if (mBootMarker.getBaseFile().exists()) {
+            mRejectedAtBoot = true;
+            mImported = null;
+            mMetadata.delete();
+            mBootMarker.delete();
+            Slog.w(TAG, "Custom font skipped after an incomplete boot");
+            return;
+        }
+        try {
+            File font = fileFor(mImported);
+            if (!VerityUtils.hasFsverity(font.getAbsolutePath())
+                    || !digest(font).equals(mImported.getString("digest"))) {
+                throw new IOException("Custom font integrity mismatch");
+            }
+            CustomFontFileValidator.Info info = CustomFontFileValidator.validate(font);
+            if (info.weight != mImported.getInt("weight")
+                    || info.italic != mImported.getBoolean("italic")) {
+                throw new IOException("Font style metadata mismatch");
+            }
+            write(mBootMarker, mImported);
+            mLoaded = mImported;
+        } catch (Exception e) {
+            mRejectedAtBoot = true;
+            mImported = null;
+            mMetadata.delete();
+            Slog.w(TAG, "Custom font unavailable; using the system fallback", e);
+        }
+    }
+
+    synchronized Bundle status() {
+        Bundle status = new Bundle();
+        status.putBoolean("supported", !mSafeMode && VerityUtils.isFsVeritySupported());
+        status.putBoolean("available", mImported != null);
+        status.putBoolean("rejectedAtBoot", mRejectedAtBoot);
+        if (mImported != null) {
+            status.putString("label", mImported.optString("label"));
+            status.putBoolean("pendingReboot", mLoaded == null
+                    || !mImported.optString("digest").equals(mLoaded.optString("digest")));
+        }
+        return status;
+    }
+
+    synchronized void install(ParcelFileDescriptor descriptor, String label) throws IOException {
+        if (mSafeMode || !VerityUtils.isFsVeritySupported()) throw new IOException("Font import unavailable");
+        if (descriptor == null) throw new IOException("No font selected");
+        try {
+            android.system.StructStat stat = Os.fstat(descriptor.getFileDescriptor());
+            if (!OsConstants.S_ISREG(stat.st_mode) || stat.st_size <= 0
+                    || stat.st_size > CustomFontFileValidator.MAX_BYTES) {
+                throw new IOException("A bounded, staged font file is required");
+            }
+            Os.lseek(descriptor.getFileDescriptor(), 0, OsConstants.SEEK_SET);
+        } catch (android.system.ErrnoException e) { throw new IOException(e); }
+        if (!mDirectory.isDirectory() && !mDirectory.mkdirs()) throw new IOException("Cannot stage font");
+        File[] retained = mDirectory.listFiles((dir, name) -> name.matches("[0-9a-f]{64}\\.font"));
+        if (retained != null && retained.length >= 4) {
+            throw new IOException("Restart before importing more fonts");
+        }
+        File temporary = File.createTempFile("staged-", ".font", mDirectory);
+        try {
+            Os.chmod(mDirectory.getAbsolutePath(), 0755);
+            try (ParcelFileDescriptor inputFd = ParcelFileDescriptor.dup(descriptor.getFileDescriptor());
+                    FileInputStream input = new FileInputStream(inputFd.getFileDescriptor());
+                    FileOutputStream output = new FileOutputStream(temporary)) {
+                byte[] buffer = new byte[16384];
+                long size = 0;
+                int count;
+                while ((count = input.read(buffer)) != -1) {
+                    size += count;
+                    if (size > CustomFontFileValidator.MAX_BYTES) throw new IOException("Font exceeds 64 MiB");
+                    output.write(buffer, 0, count);
+                }
+                output.getFD().sync();
+            }
+            CustomFontFileValidator.Info info = CustomFontFileValidator.validate(temporary);
+            String hash = digest(temporary);
+            File destination = new File(mDirectory, hash + ".font");
+            if (!destination.exists()) {
+                // Publish an immutable file before publishing the metadata pointing to it.
+                // Enabling fs-verity requires owner write permission, with no open writers.
+                // Seal the content first, then publish its read-only mode and final name.
+                VerityUtils.setUpFsverity(temporary.getAbsolutePath());
+                Os.chmod(temporary.getAbsolutePath(), 0444);
+                if (!temporary.renameTo(destination)) throw new IOException("Cannot publish font");
+            }
+            if (!VerityUtils.hasFsverity(destination.getAbsolutePath())
+                    || !digest(destination).equals(hash)) throw new IOException("Font integrity check failed");
+            JSONObject metadata = new JSONObject();
+            metadata.put("digest", hash);
+            metadata.put("label", cleanLabel(label));
+            metadata.put("weight", info.weight);
+            metadata.put("italic", info.italic);
+            write(mMetadata, metadata);
+            mImported = metadata;
+            mRejectedAtBoot = false;
+            // Keep the running font map and every file it can reference until reboot.
+        } catch (IOException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IOException("Could not import font", e);
+        } finally {
+            temporary.delete();
+        }
+    }
+
+    synchronized ParcelFileDescriptor openPreview() throws IOException {
+        if (mImported == null) throw new IOException("No custom font");
+        try {
+            return ParcelFileDescriptor.open(fileFor(mImported), ParcelFileDescriptor.MODE_READ_ONLY);
+        } catch (Exception e) {
+            throw new IOException("Cannot open preview", e);
+        }
+    }
+
+    synchronized void remove() {
+        mMetadata.delete();
+        mImported = null;
+        // Do not unlink files mapped by existing processes.
+    }
+
+    synchronized JSONObject snapshotImported() { return mImported; }
+
+    synchronized void restoreImported(JSONObject previous) throws IOException {
+        if (previous == null) mMetadata.delete();
+        else write(mMetadata, previous);
+        mImported = previous;
+    }
+
+    synchronized void onBootCompleted() {
+        mBootMarker.delete();
+        // Previous boot's processes no longer exist; only remove our own unused slot files.
+        File keep = null;
+        try { if (mLoaded != null) keep = fileFor(mLoaded); } catch (Exception e) { return; }
+        File[] files = mDirectory.listFiles();
+        if (files == null) return;
+        for (File file : files) {
+            if (file.getName().matches("[0-9a-f]{64}\\.font") && !file.equals(keep)
+                    && (mImported == null || !file.getName().equals(mImported.optString("digest") + ".font"))) {
+                file.delete();
+            }
+        }
+    }
+
+    synchronized boolean hasLoadedFont() { return mLoaded != null; }
+
+    synchronized void rejectLoadedFont() {
+        mLoaded = null;
+        mImported = null;
+        mRejectedAtBoot = true;
+        mMetadata.delete();
+    }
+
+    synchronized FontConfig decorate(FontConfig base) {
+        List<FontConfig.NamedFamilyList> named = new ArrayList<>(base.getNamedFamilyLists());
+        List<FontConfig.Alias> aliases = new ArrayList<>(base.getAliases());
+        if (mLoaded != null) {
+            try {
+                FontConfig.Font font = new FontConfig.Font(fileFor(mLoaded), null, "DitingUserCustomFont",
+                        new FontStyle(mLoaded.getInt("weight"), mLoaded.getBoolean("italic")
+                                ? FontStyle.FONT_SLANT_ITALIC : FontStyle.FONT_SLANT_UPRIGHT),
+                        0, "", null, 0);
+                FontConfig.FontFamily family = new FontConfig.FontFamily(Collections.singletonList(font),
+                        LocaleList.getEmptyLocaleList(), 0);
+                // Retain the complete stock fallback chain, including CJK and emoji.
+                named.add(new FontConfig.NamedFamilyList(Collections.singletonList(family), FAMILY, null));
+            } catch (Exception e) {
+                Slog.w(TAG, "Cannot attach custom font", e);
+                addDefaultAlias(base, aliases);
+            }
+        } else {
+            addDefaultAlias(base, aliases);
+        }
+        return new FontConfig(base.getFontFamilies(), aliases, named,
+                base.getLocaleFallbackCustomizations(), base.getLastModifiedTimeMillis(), base.getConfigVersion());
+    }
+
+    private static void addDefaultAlias(FontConfig base, List<FontConfig.Alias> aliases) {
+        String defaultFamily = Resources.getSystem().getString(com.android.internal.R.string.config_bodyFontFamily);
+        boolean exists = base.getNamedFamilyLists().stream().anyMatch(family -> family.getName().equals(defaultFamily));
+        aliases.add(new FontConfig.Alias(FAMILY, exists ? defaultFamily : "sans-serif", 400));
+    }
+
+    private JSONObject readMetadata() {
+        try (FileInputStream input = mMetadata.openRead()) {
+            if (input.getChannel().size() > 4096) return null;
+            JSONObject metadata = new JSONObject(new String(input.readAllBytes(), StandardCharsets.UTF_8));
+            fileFor(metadata);
+            return metadata;
+        } catch (Exception e) { return null; }
+    }
+
+    private File fileFor(JSONObject metadata) throws Exception {
+        String digest = metadata.getString("digest");
+        if (!digest.matches("[0-9a-f]{64}")) throw new IOException("Invalid font identity");
+        return new File(mDirectory, digest + ".font");
+    }
+
+    private static String digest(File file) throws Exception {
+        MessageDigest digest = MessageDigest.getInstance("SHA-256");
+        try (FileInputStream input = new FileInputStream(file)) {
+            byte[] buffer = new byte[16384];
+            int size;
+            while ((size = input.read(buffer)) != -1) digest.update(buffer, 0, size);
+        }
+        StringBuilder result = new StringBuilder();
+        for (byte value : digest.digest()) result.append(String.format("%02x", value & 0xff));
+        return result.toString();
+    }
+
+    private static String cleanLabel(String label) {
+        String clean = label == null ? "Custom font" : label.replaceAll("[\\p{Cntrl}]", "").trim();
+        return clean.isEmpty() ? "Custom font" : clean.substring(0, Math.min(clean.length(), 80));
+    }
+
+    private static void write(AtomicFile file, JSONObject metadata) throws IOException {
+        FileOutputStream output = null;
+        try {
+            output = file.startWrite();
+            output.write(metadata.toString().getBytes(StandardCharsets.UTF_8));
+            file.finishWrite(output);
+        } catch (IOException e) {
+            if (output != null) file.failWrite(output);
+            throw e;
+        }
+    }
