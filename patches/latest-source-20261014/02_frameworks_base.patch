+/* Copyright (C) 2026 diting AviumUI contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.internal.graphics.fonts;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Conservative validation for explicitly selected, single-face static SFNT files. @hide */
+public final class CustomFontFileValidator {
+    public static final long MAX_BYTES = 64L * 1024 * 1024;
+
+    public static final class Info {
+        public final int weight;
+        public final boolean italic;
+        Info(int weight, boolean italic) {
+            this.weight = weight;
+            this.italic = italic;
+        }
+    }
+
+    public static Info validate(File file) throws IOException {
+        try (RandomAccessFile input = new RandomAccessFile(file, "r")) {
+            long size = input.length();
+            if (size < 12 || size > MAX_BYTES) throw new IOException("Invalid font size");
+            int version = input.readInt();
+            if (version != 0x00010000 && version != 0x4f54544f) {
+                throw new IOException("Only single-face TTF or OTF is supported");
+            }
+            int count = input.readUnsignedShort();
+            long directoryEnd = 12L + count * 16L;
+            if (count == 0 || count > 256 || directoryEnd > size) {
+                throw new IOException("Invalid font table directory");
+            }
+            input.seek(12);
+            Map<Integer, long[]> tables = new HashMap<>();
+            for (int i = 0; i < count; i++) {
+                int tag = input.readInt();
+                input.readInt(); // Table checksum; renderability is also checked by the UI.
+                long offset = Integer.toUnsignedLong(input.readInt());
+                long length = Integer.toUnsignedLong(input.readInt());
+                if (offset < directoryEnd || offset > size || length > size - offset
+                        || (offset & 3) != 0 || tables.put(tag, new long[] {offset, length}) != null) {
+                    throw new IOException("Invalid or duplicate font table");
+                }
+            }
+            if (tables.containsKey(tag("fvar")) || tables.containsKey(tag("CFF2"))) {
+                throw new IOException("Variable fonts are not supported in this version");
+            }
+            long[] head = require(tables, "head", 54);
+            long[] maxp = require(tables, "maxp", 6);
+            require(tables, "cmap", 4);
+            require(tables, "name", 6);
+            require(tables, "hhea", 36);
+            require(tables, "hmtx", 2);
+            if (version == 0x00010000) {
+                require(tables, "glyf", 1);
+                require(tables, "loca", 2);
+            } else {
+                require(tables, "CFF ", 4);
+            }
+            input.seek(head[0] + 12);
+            if (input.readInt() != 0x5f0f3cf5) throw new IOException("Invalid font header");
+            input.seek(head[0] + 18);
+            int units = input.readUnsignedShort();
+            if (units < 16 || units > 16384) throw new IOException("Invalid font units");
+            input.seek(maxp[0] + 4);
+            if (input.readUnsignedShort() == 0) throw new IOException("Font has no glyphs");
+            long[] os2 = require(tables, "OS/2", 64);
+            input.seek(os2[0] + 4);
+            int weight = input.readUnsignedShort();
+            if (weight < 1 || weight > 1000) throw new IOException("Invalid font weight");
+            input.seek(os2[0] + 62);
+            int selection = input.readUnsignedShort();
+            return new Info(weight, (selection & 0x201) != 0);
+        }
+    }
+
+    private static long[] require(Map<Integer, long[]> tables, String name, long minimum)
+            throws IOException {
+        long[] table = tables.get(tag(name));
+        if (table == null || table[1] < minimum) throw new IOException("Missing font table " + name);
+        return table;
+    }
+
+    private static int tag(String name) {
+        return name.charAt(0) << 24 | name.charAt(1) << 16
+                | name.charAt(2) << 8 | name.charAt(3);
+    }
+
+    private CustomFontFileValidator() {}
+}
