+/* Copyright (C) 2026 diting AviumUI contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.display;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/** Edits only the font category of the shared system theme configuration. */
+final class FontStyleConfig {
+    static final String CUSTOM = "com.android.theme.font.custom";
+    static final String CATEGORY = "android.theme.customization.font";
+    static final String DEFAULT = "default";
+    static final String CONDENSED = "com.android.theme.font.condensed";
+    static final String SOURCE = "com.android.theme.font.sourcesanspro";
+    static final String SERIF = "com.android.theme.font.notoserif";
+
+    static boolean isKnownKey(String key) {
+        return DEFAULT.equals(key) || CONDENSED.equals(key)
+                || SOURCE.equals(key) || SERIF.equals(key) || CUSTOM.equals(key);
+    }
+
+    static String selectedKey(String json) {
+        try {
+            String key = parse(json).optString(CATEGORY, DEFAULT);
+            return isKnownKey(key) ? key : DEFAULT;
+        } catch (JSONException e) {
+            return DEFAULT;
+        }
+    }
+
+    static String withFont(String json, String key) throws JSONException {
+        if (!isKnownKey(key)) {
+            throw new IllegalArgumentException("Unknown font style");
+        }
+        // Do not silently discard colours, icon shapes or a malformed existing theme.
+        JSONObject theme = parse(json);
+        if (DEFAULT.equals(key)) {
+            theme.remove(CATEGORY);
+        } else {
+            theme.put(CATEGORY, key);
+        }
+        return theme.toString();
+    }
+
+    private static JSONObject parse(String json) throws JSONException {
+        return json == null || json.isEmpty() ? new JSONObject() : new JSONObject(json);
+    }
+
+    private FontStyleConfig() {}
+}
