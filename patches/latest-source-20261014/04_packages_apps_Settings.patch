diff --git a/src/com/android/settings/display/CustomFontImport.java b/src/com/android/settings/display/CustomFontImport.java
new file mode 100644
index 0000000000000000000000000000000000000000..425652fc45a9d6de56f62bfe6c16da4e73de7abb
--- /dev/null
+++ b/src/com/android/settings/display/CustomFontImport.java
@@ -0,0 +1,251 @@
+/* Copyright (C) 2026 diting AviumUI contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.display;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Intent;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.ServiceConnection;
+import android.database.Cursor;
+import android.graphics.Typeface;
+import android.graphics.fonts.Font;
+import android.graphics.fonts.FontFamily;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.Message;
+import android.os.Messenger;
+import android.os.ParcelFileDescriptor;
+import android.os.PowerManager;
+import android.os.ServiceManager;
+import android.provider.OpenableColumns;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.android.internal.graphics.fonts.CustomFontFileValidator;
+import com.android.internal.graphics.fonts.IFontManager;
+import com.android.settings.R;
+import com.android.settingslib.utils.ThreadUtils;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+
+/** User-initiated, copied imports; no persistent grants and no original file modification. */
+final class CustomFontImport {
+    static final int REQUEST_FONT = 6401;
+    private final FontStyleSettings mFragment;
+    private boolean mBusy;
+
+    CustomFontImport(FontStyleSettings fragment) { mFragment = fragment; }
+
+    private static IFontManager manager() {
+        return IFontManager.Stub.asInterface(ServiceManager.getService(android.content.Context.FONT_SERVICE));
+    }
+
+    static Bundle status() {
+        try {
+            IFontManager manager = manager();
+            return manager == null ? null : manager.getUserCustomFontStatus();
+        } catch (Exception | LinkageError e) { return null; }
+    }
+
+    static Typeface previewTypeface() {
+        try (ParcelFileDescriptor descriptor = manager().openUserCustomFont()) {
+            Font font = new Font.Builder(descriptor).build();
+            return new Typeface.CustomFallbackBuilder(new FontFamily.Builder(font).build())
+                    .setSystemFallback("sans-serif").build();
+        } catch (Exception | LinkageError e) { return Typeface.DEFAULT; }
+    }
+
+    void pick() {
+        if (mBusy) return;
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType("*/*");
+        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        mFragment.startActivityForResult(intent, REQUEST_FONT);
+    }
+
+    void result(int resultCode, Intent data) {
+        if (resultCode != Activity.RESULT_OK || data == null || data.getData() == null || mBusy) return;
+        mBusy = true;
+        Uri uri = data.getData();
+        Activity activity = mFragment.getActivity();
+        if (activity == null) { mBusy = false; return; }
+        Toast.makeText(activity, R.string.font_custom_checking, Toast.LENGTH_SHORT).show();
+        ThreadUtils.postOnBackgroundThread(() -> {
+            File staged = null;
+            try {
+                String label = "Custom font";
+                try (Cursor cursor = activity.getContentResolver().query(uri,
+                        new String[] {OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+                    if (cursor != null && cursor.moveToFirst()) label = cursor.getString(0);
+                }
+                staged = File.createTempFile("font-import-", ".font", activity.getCacheDir());
+                try (InputStream input = activity.getContentResolver().openInputStream(uri);
+                        FileOutputStream output = new FileOutputStream(staged)) {
+                    if (input == null) throw new java.io.IOException("Missing font stream");
+                    byte[] buffer = new byte[16384];
+                    long size = 0;
+                    int count;
+                    while ((count = input.read(buffer)) != -1) {
+                        size += count;
+                        if (size > CustomFontFileValidator.MAX_BYTES) throw new java.io.IOException("Too large");
+                        output.write(buffer, 0, count);
+                    }
+                    output.getFD().sync();
+                }
+                CustomFontFileValidator.validate(staged);
+                if (!staged.setReadOnly()) throw new java.io.IOException("Cannot seal preview");
+                File accepted = staged;
+                String name = label;
+                activity.runOnUiThread(() -> {
+                    if (!mFragment.isAdded() || activity.isFinishing()) { mBusy = false; accepted.delete(); return; }
+                    validateIsolated(accepted, name);
+                });
+                staged = null;
+            } catch (Exception | LinkageError e) {
+                if (staged != null) staged.delete();
+                activity.runOnUiThread(() -> {
+                    mBusy = false;
+                    if (mFragment.isAdded()) Toast.makeText(activity, R.string.font_custom_invalid,
+                            Toast.LENGTH_LONG).show();
+                });
+            }
+        });
+    }
+
+    private void validateIsolated(File file, String label) {
+        Activity activity = mFragment.getActivity();
+        Handler handler = new Handler(Looper.getMainLooper());
+        final boolean[] finished = {false};
+        final boolean[] bound = {false};
+        final ServiceConnection[] connection = new ServiceConnection[1];
+        java.util.function.Consumer<Boolean> complete = valid -> {
+            if (finished[0]) return;
+            finished[0] = true;
+            if (bound[0]) activity.unbindService(connection[0]);
+            mBusy = false;
+            if (!valid || !mFragment.isAdded() || activity.isFinishing()) {
+                file.delete();
+                if (mFragment.isAdded()) Toast.makeText(activity, R.string.font_custom_invalid, Toast.LENGTH_LONG).show();
+                return;
+            }
+            try {
+                Font font = new Font.Builder(file).build();
+                Typeface typeface = new Typeface.CustomFallbackBuilder(new FontFamily.Builder(font).build())
+                        .setSystemFallback("sans-serif").build();
+                showPreview(file, label, typeface);
+            } catch (Exception e) {
+                file.delete();
+                Toast.makeText(activity, R.string.font_custom_invalid, Toast.LENGTH_LONG).show();
+            }
+        };
+        Messenger reply = new Messenger(new Handler(Looper.getMainLooper()) {
+            @Override public void handleMessage(Message message) { complete.accept(message.arg1 == 1); }
+        });
+        connection[0] = new ServiceConnection() {
+            @Override public void onServiceConnected(ComponentName component, IBinder binder) {
+                ThreadUtils.postOnBackgroundThread(() -> {
+                    // Isolated processes cannot read Settings' system_app_data_file cache.
+                    // A sealed appdomain_tmpfs descriptor is shared without opening any path.
+                    try (android.os.SharedMemory memory = android.os.SharedMemory.create(
+                            "font_validation", Math.toIntExact(file.length()))) {
+                        java.nio.ByteBuffer mapping = memory.mapReadWrite();
+                        try (InputStream input = new java.io.FileInputStream(file)) {
+                            byte[] buffer = new byte[16384];
+                            int count;
+                            while ((count = input.read(buffer)) != -1) mapping.put(buffer, 0, count);
+                        } finally {
+                            android.os.SharedMemory.unmap(mapping);
+                        }
+                        if (!memory.setProtect(android.system.OsConstants.PROT_READ)) {
+                            throw new java.io.IOException("Cannot seal validation memory");
+                        }
+                        Message request = Message.obtain();
+                        Bundle data = new Bundle();
+                        data.putParcelable("font", memory);
+                        request.setData(data);
+                        request.replyTo = reply;
+                        new Messenger(binder).send(request);
+                    } catch (Exception e) { handler.post(() -> complete.accept(false)); }
+                });
+            }
+            @Override public void onServiceDisconnected(ComponentName component) { complete.accept(false); }
+            @Override public void onBindingDied(ComponentName component) { complete.accept(false); }
+        };
+        try {
+            bound[0] = activity.bindService(new Intent(activity, FontImportValidationService.class),
+                    connection[0], Context.BIND_AUTO_CREATE);
+            if (!bound[0]) complete.accept(false);
+            handler.postDelayed(() -> complete.accept(false), 20000);
+        } catch (Exception e) { complete.accept(false); }
+    }
+
+    private void showPreview(File file, String label, Typeface typeface) {
+        Activity activity = mFragment.getActivity();
+        LinearLayout preview = new LinearLayout(activity);
+        preview.setOrientation(LinearLayout.VERTICAL);
+        int padding = Math.round(24 * activity.getResources().getDisplayMetrics().density);
+        preview.setPadding(padding, padding, padding, padding);
+        TextView name = new TextView(activity);
+        String displayLabel = label == null ? "Custom font" : label.replaceAll("[\\p{Cntrl}]", "").trim();
+        name.setText(displayLabel.substring(0, Math.min(displayLabel.length(), 80)));
+        preview.addView(name);
+        TextView sample = new TextView(activity);
+        sample.setText(R.string.font_style_preview);
+        sample.setTextSize(22);
+        sample.setTypeface(typeface);
+        preview.addView(sample);
+        TextView note = new TextView(activity);
+        note.setText(R.string.font_custom_restart_note);
+        preview.addView(note);
+        new AlertDialog.Builder(activity).setTitle(R.string.font_custom_preview)
+                .setView(preview).setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.font_custom_save_restart, (dialog, which) -> apply(file, label))
+                .setOnDismissListener(dialog -> { if (!mBusy) file.delete(); }).show();
+    }
+
+    private void apply(File file, String label) {
+        mBusy = true;
+        Activity activity = mFragment.getActivity();
+        ThreadUtils.postOnBackgroundThread(() -> {
+            boolean success = false;
+            try (ParcelFileDescriptor descriptor = ParcelFileDescriptor.open(file, ParcelFileDescriptor.MODE_READ_ONLY)) {
+                manager().installUserCustomFont(descriptor, label);
+                success = true;
+            } catch (Exception | LinkageError e) { /* Keep the previous theme selection on failure. */ }
+            finally { file.delete(); }
+            boolean applied = success;
+            activity.runOnUiThread(() -> {
+                mBusy = false;
+                if (applied) activity.getSystemService(PowerManager.class).reboot(null);
+                else if (mFragment.isAdded()) Toast.makeText(activity, R.string.font_custom_apply_error,
+                        Toast.LENGTH_LONG).show();
+            });
+        });
+    }
+
+    void remove() {
+        Activity activity = mFragment.getActivity();
+        new AlertDialog.Builder(activity).setTitle(R.string.font_custom_remove)
+                .setMessage(R.string.font_custom_remove_note)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(android.R.string.ok, (dialog, which) -> {
+                    try {
+                        if (!mFragment.restoreBeforeRemovingImport()) throw new IllegalStateException();
+                        manager().removeUserCustomFont();
+                        activity.recreate();
+                    } catch (Exception | LinkageError e) {
+                        Toast.makeText(activity, R.string.font_custom_apply_error, Toast.LENGTH_LONG).show();
+                    }
+                }).show();
+    }
+}
diff --git a/src/com/android/settings/display/FontImportValidationService.java b/src/com/android/settings/display/FontImportValidationService.java
new file mode 100644
index 0000000000000000000000000000000000000000..524ef8eae5d9b84043e557337512e6ec7ea975cb
--- /dev/null
+++ b/src/com/android/settings/display/FontImportValidationService.java
@@ -0,0 +1,54 @@
+/* Copyright (C) 2026 diting AviumUI contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.display;
+
+import android.app.Service;
+import android.content.Intent;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Typeface;
+import android.graphics.fonts.Font;
+import android.graphics.fonts.FontFamily;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.Message;
+import android.os.Messenger;
+import android.os.SharedMemory;
+
+/** Native font parsing/rasterization occurs in an unprivileged isolated process first. */
+public final class FontImportValidationService extends Service {
+    private final Messenger mMessenger = new Messenger(new Handler(Looper.getMainLooper()) {
+        @Override public void handleMessage(Message message) {
+            boolean valid = false;
+            Bitmap bitmap = null;
+            try (SharedMemory memory = message.getData().getParcelable("font", SharedMemory.class)) {
+                if (memory == null) return;
+                // Ashmem descriptors can report st_size=0; use the region's actual bounds.
+                // Font retains the mapped direct buffer; its cleaner owns the mapping lifetime.
+                Font font = new Font.Builder(memory.mapReadOnly()).build();
+                Typeface face = new Typeface.CustomFallbackBuilder(new FontFamily.Builder(font).build())
+                        .setSystemFallback("sans-serif").build();
+                bitmap = Bitmap.createBitmap(512, 128, Bitmap.Config.ARGB_8888);
+                Paint paint = new Paint();
+                paint.setTypeface(face);
+                paint.setTextSize(28);
+                new Canvas(bitmap).drawText("Aa 0123 中文繁體 😀", 4, 64, paint);
+                valid = true;
+            } catch (Exception e) {
+                valid = false;
+            } finally {
+                if (bitmap != null) bitmap.recycle();
+            }
+            try {
+                Message reply = Message.obtain();
+                reply.arg1 = valid ? 1 : 0;
+                if (message.replyTo != null) message.replyTo.send(reply);
+            } catch (android.os.RemoteException e) { /* The requesting screen was closed. */ }
+        }
+    });
+
+    @Override public IBinder onBind(Intent intent) { return mMessenger.getBinder(); }
+}
