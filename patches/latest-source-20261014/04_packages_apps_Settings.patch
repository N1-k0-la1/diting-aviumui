+++ b/tests/robotests/src/com/android/settings/display/FontStyleConfigTest.java
@@ -0,0 +1,54 @@
+/* Copyright (C) 2026 diting AviumUI contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.display;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.junit.Assert.assertThrows;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+
+@RunWith(RobolectricTestRunner.class)
+public class FontStyleConfigTest {
+    @Test
+    public void changeFont_keepsColoursIconsAndUnknownFields() throws Exception {
+        String existing = "{\"android.theme.customization.system_palette\":\"abcdef\","
+                + "\"android.theme.customization.adaptive_icon_shape\":\"shape.package\","
+                + "\"future\":{\"nested\":[1,true,\"value\"]}}";
+        JSONObject result = new JSONObject(FontStyleConfig.withFont(existing, FontStyleConfig.SERIF));
+        assertThat(result.getString("android.theme.customization.system_palette")).isEqualTo("abcdef");
+        assertThat(result.getString("android.theme.customization.adaptive_icon_shape")).isEqualTo("shape.package");
+        assertThat(result.getJSONObject("future").getJSONArray("nested").getBoolean(1)).isTrue();
+        assertThat(result.getString(FontStyleConfig.CATEGORY)).isEqualTo(FontStyleConfig.SERIF);
+    }
+
+    @Test
+    public void restoreDefault_removesOnlyFontChoice() throws Exception {
+        String existing = "{\"android.theme.customization.font\":\"other.font\",\"colour\":42}";
+        JSONObject result = new JSONObject(FontStyleConfig.withFont(existing, FontStyleConfig.DEFAULT));
+        assertThat(result.has(FontStyleConfig.CATEGORY)).isFalse();
+        assertThat(result.getInt("colour")).isEqualTo(42);
+    }
+
+    @Test
+    public void malformedTheme_isRejectedInsteadOfDiscardingSettings() {
+        assertThrows(JSONException.class, () -> FontStyleConfig.withFont("{invalid", FontStyleConfig.SOURCE));
+    }
+
+    @Test
+    public void unknownFont_isRejected() {
+        assertThrows(IllegalArgumentException.class, () -> FontStyleConfig.withFont("{}", "foreign.package"));
+    }
+
+    @Test
+    public void emptyThemeAndSavedSelection_areHandled() throws Exception {
+        assertThat(FontStyleConfig.selectedKey(null)).isEqualTo(FontStyleConfig.DEFAULT);
+        assertThat(FontStyleConfig.selectedKey("{invalid")).isEqualTo(FontStyleConfig.DEFAULT);
+        assertThat(FontStyleConfig.selectedKey(FontStyleConfig.withFont("", FontStyleConfig.CONDENSED)))
+                .isEqualTo(FontStyleConfig.CONDENSED);
+    }
+}
