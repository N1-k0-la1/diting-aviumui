--- /dev/null
+++ b/src/com/android/settings/display/FontStylePreferenceController.java
@@ -0,0 +1,57 @@
+/* Copyright (C) 2026 diting AviumUI contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.display;
+
+import android.content.Context;
+import android.content.om.OverlayInfo;
+import android.content.om.OverlayManager;
+import android.os.UserHandle;
+import android.os.UserManager;
+import android.provider.Settings;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+public class FontStylePreferenceController extends BasePreferenceController {
+    public FontStylePreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        if (mContext.getSystemService(UserManager.class).isManagedProfile()) {
+            return DISABLED_FOR_USER;
+        }
+        return hasPresets(mContext) ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    static boolean hasPresets(Context context) {
+        OverlayManager manager = context.getSystemService(OverlayManager.class);
+        if (manager == null) return false;
+        for (String key : new String[] {
+                FontStyleConfig.CONDENSED, FontStyleConfig.SOURCE, FontStyleConfig.SERIF}) {
+            OverlayInfo info = manager.getOverlayInfo(key, UserHandle.of(context.getUserId()));
+            if (info == null || !"android".equals(info.targetPackageName)
+                    || !FontStyleConfig.CATEGORY.equals(info.category)
+                    || !info.isMutable) return false;
+        }
+        return true;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        String key = FontStyleConfig.selectedKey(Settings.Secure.getStringForUser(
+                mContext.getContentResolver(), Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES,
+                mContext.getUserId()));
+        return mContext.getText(titleFor(key));
+    }
+
+    static int titleFor(String key) {
+        if (FontStyleConfig.CUSTOM.equals(key)) return R.string.font_custom_title;
+        if (FontStyleConfig.CONDENSED.equals(key)) return R.string.font_style_condensed;
+        if (FontStyleConfig.SOURCE.equals(key)) return R.string.font_style_source;
+        if (FontStyleConfig.SERIF.equals(key)) return R.string.font_style_serif;
+        return R.string.font_style_default;
+    }
+}
diff --git a/src/com/android/settings/display/FontStyleSettings.java b/src/com/android/settings/display/FontStyleSettings.java
new file mode 100644
index 0000000000000000000000000000000000000000..bfd9b7872b2c7d874c35367be3f474bed0582a63
--- /dev/null
+++ b/src/com/android/settings/display/FontStyleSettings.java
@@ -0,0 +1,238 @@
+/* Copyright (C) 2026 diting AviumUI contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.display;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.content.res.Resources;
+import android.database.ContentObserver;
+import android.graphics.Typeface;
+import android.graphics.drawable.Drawable;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.util.Log;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+import androidx.preference.PreferenceViewHolder;
+
+import com.android.settings.R;
+import com.android.settings.search.BaseSearchIndexProvider;
+import com.android.settings.widget.RadioButtonPickerFragment;
+import com.android.settingslib.search.SearchIndexable;
+import com.android.settingslib.widget.CandidateInfo;
+import com.android.settingslib.widget.SelectorWithWidgetPreference;
+
+import org.json.JSONException;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Previews and switches the platform's installed fonts through its existing theme service. */
+@SearchIndexable
+public class FontStyleSettings extends RadioButtonPickerFragment {
+    private final CustomFontImport mCustomImport = new CustomFontImport(this);
+    private boolean mCustomSelection;
+    private static final String TAG = "FontStyleSettings";
+    private final ContentObserver mThemeObserver = new ContentObserver(
+            new Handler(Looper.getMainLooper())) {
+        @Override
+        public void onChange(boolean selfChange) {
+            if (getPreferenceScreen() != null) updateCheckedState(getDefaultKey());
+        }
+    };
+
+    @Override
+    protected int getPreferenceScreenResId() { return R.xml.font_style_settings; }
+
+    @Override
+    public int getMetricsCategory() { return SettingsEnums.DISPLAY; }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        getContext().getContentResolver().registerContentObserver(
+                Settings.Secure.getUriFor(Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES),
+                false, mThemeObserver, mUserId);
+        updateCheckedState(getDefaultKey());
+    }
+
+    @Override
+    public void onPause() {
+        getContext().getContentResolver().unregisterContentObserver(mThemeObserver);
+        super.onPause();
+    }
+
+    @Override
+    protected List<? extends CandidateInfo> getCandidates() {
+        List<FontCandidate> list = new ArrayList<>();
+        // System resources include the immutable product default (e.g. Google Sans on GMS),
+        // but not the mutable font choice, so this preview stays faithful after switching.
+        String defaultFamily = Resources.getSystem().getString(
+                com.android.internal.R.string.config_bodyFontFamily);
+        list.add(new FontCandidate(FontStyleConfig.DEFAULT,
+                defaultFamily.isEmpty() ? "sans-serif" : defaultFamily));
+        list.add(new FontCandidate(FontStyleConfig.CONDENSED, "sans-serif-condensed"));
+        list.add(new FontCandidate(FontStyleConfig.SOURCE, "source-sans-pro"));
+        list.add(new FontCandidate(FontStyleConfig.SERIF, "serif"));
+        android.os.Bundle imported = CustomFontImport.status();
+        if (imported != null && imported.getBoolean("available")) {
+            list.add(new FontCandidate(FontStyleConfig.CUSTOM, "diting-user-custom"));
+        }
+        return list;
+    }
+
+    @Override
+    protected String getDefaultKey() {
+        return FontStyleConfig.selectedKey(Settings.Secure.getStringForUser(
+                getContext().getContentResolver(), Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES,
+                mUserId));
+    }
+
+    @Override
+    protected boolean setDefaultKey(String key) {
+        if (!FontStyleConfig.isKnownKey(key)) return false;
+        mCustomSelection = FontStyleConfig.CUSTOM.equals(key);
+        if (mCustomSelection) {
+            android.os.Bundle imported = CustomFontImport.status();
+            if (imported == null || !imported.getBoolean("available")) return false;
+        }
+        if (!FontStyleConfig.DEFAULT.equals(key)
+                && !FontStylePreferenceController.hasPresets(getContext())) return false;
+        try {
+            String current = Settings.Secure.getStringForUser(getContext().getContentResolver(),
+                    Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES, mUserId);
+            // SystemUI applies this category for the current user, system user and work profiles,
+            // and restores it at boot. Updating the shared JSON keeps wallpaper changes compatible.
+            return Settings.Secure.putStringForUser(getContext().getContentResolver(),
+                    Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES,
+                    FontStyleConfig.withFont(current, key), mUserId);
+        } catch (JSONException | IllegalArgumentException | SecurityException e) {
+            Log.w(TAG, "Could not change font style", e);
+            return false;
+        }
+    }
+
+    @Override
+    protected void onSelectionPerformed(boolean success) {
+        if (success && mCustomSelection) {
+            new android.app.AlertDialog.Builder(getContext()).setMessage(R.string.font_custom_restart_note)
+                    .setNegativeButton(R.string.font_custom_later, null)
+                    .setPositiveButton(R.string.font_custom_restart, (dialog, which) ->
+                            getContext().getSystemService(android.os.PowerManager.class).reboot(null)).show();
+        }
+        if (!success) Toast.makeText(getContext(), R.string.font_style_apply_error,
+                Toast.LENGTH_LONG).show();
+    }
+
+    @Override
+    protected void addStaticPreferences(PreferenceScreen screen) {
+        Preference restore = new Preference(getPrefContext());
+        restore.setKey("font_style_restore");
+        restore.setTitle(R.string.font_style_restore);
+        restore.setPersistent(false);
+        restore.setOnPreferenceClickListener(pref -> {
+            onRadioButtonConfirmed(FontStyleConfig.DEFAULT);
+            return true;
+        });
+        screen.addPreference(restore);
+        Preference note = new Preference(getPrefContext());
+        note.setKey("font_style_note");
+        note.setTitle(R.string.font_style_note);
+        note.setSelectable(false);
+        screen.addPreference(note);
+        android.os.Bundle imported = CustomFontImport.status();
+        if (imported != null && imported.getBoolean("supported")) {
+            Preference pick = new Preference(getPrefContext());
+            pick.setKey("font_custom_import");
+            pick.setTitle(R.string.font_custom_import);
+            pick.setSummary(R.string.font_custom_supported);
+            pick.setOnPreferenceClickListener(pref -> { mCustomImport.pick(); return true; });
+            screen.addPreference(pick);
+        }
+        if (imported != null && imported.getBoolean("available")) {
+            Preference remove = new Preference(getPrefContext());
+            remove.setKey("font_custom_remove");
+            remove.setTitle(R.string.font_custom_remove);
+            remove.setOnPreferenceClickListener(pref -> { mCustomImport.remove(); return true; });
+            screen.addPreference(remove);
+        }
+    }
+
+    @Override
+    protected SelectorWithWidgetPreference createPreference() {
+        return new FontPreviewPreference(getPrefContext());
+    }
+
+    @Override
+    public void bindPreferenceExtra(SelectorWithWidgetPreference preference, String key,
+            CandidateInfo info, String defaultKey, String systemDefaultKey) {
+        FontCandidate candidate = (FontCandidate) info;
+        ((FontPreviewPreference) preference).mFamily = candidate.family;
+        if (FontStyleConfig.CUSTOM.equals(key)) {
+            ((FontPreviewPreference) preference).mImportedTypeface = CustomFontImport.previewTypeface();
+        }
+        preference.setSingleLineTitle(false);
+        preference.setSummary(getString(R.string.font_style_preview)
+                + "\n" + getString(FontStyleConfig.SERIF.equals(key)
+                        ? R.string.font_style_serif_note : R.string.font_style_latin_note));
+        preference.setPersistent(false);
+    }
+
+    private final class FontCandidate extends CandidateInfo {
+        final String key;
+        final String family;
+        FontCandidate(String key, String family) {
+            super(true);
+            this.key = key;
+            this.family = family;
+        }
+        @Override
+        public CharSequence loadLabel() {
+            if (FontStyleConfig.CUSTOM.equals(key)) {
+                android.os.Bundle imported = CustomFontImport.status();
+                return getString(R.string.font_custom_named, imported == null ? "" : imported.getString("label", ""));
+            }
+            return getContext().getText(FontStylePreferenceController.titleFor(key));
+        }
+        @Override
+        public Drawable loadIcon() { return null; }
+        @Override
+        public String getKey() { return key; }
+    }
+
+    private static final class FontPreviewPreference extends SelectorWithWidgetPreference {
+        Typeface mImportedTypeface;
+        String mFamily = "sans-serif";
+        FontPreviewPreference(Context context) { super(context); }
+        @Override
+        public void onBindViewHolder(PreferenceViewHolder holder) {
+            super.onBindViewHolder(holder);
+            TextView title = (TextView) holder.findViewById(android.R.id.title);
+            TextView sample = (TextView) holder.findViewById(android.R.id.summary);
+            if (title != null) title.setTypeface(mImportedTypeface == null ? Typeface.create(mFamily, Typeface.BOLD) : Typeface.create(mImportedTypeface, Typeface.BOLD));
+            if (sample != null) {
+                sample.setTypeface(mImportedTypeface == null ? Typeface.create(mFamily, Typeface.NORMAL) : mImportedTypeface);
+                sample.setSingleLine(false);
+                sample.setMaxLines(Integer.MAX_VALUE);
+                sample.setEllipsize(null);
+            }
+        }
+    }
+
+    @Override public void onActivityResult(int requestCode, int resultCode, android.content.Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode == CustomFontImport.REQUEST_FONT) mCustomImport.result(resultCode, data);
+    }
+
+    boolean restoreBeforeRemovingImport() {
+        return !FontStyleConfig.CUSTOM.equals(getDefaultKey()) || setDefaultKey(FontStyleConfig.DEFAULT);
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(R.xml.font_style_settings);
+}
diff --git a/tests/robotests/src/com/android/settings/display/FontStyleConfigTest.java b/tests/robotests/src/com/android/settings/display/FontStyleConfigTest.java
