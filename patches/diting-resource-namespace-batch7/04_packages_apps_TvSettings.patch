From 2fcd1053d348887fde308378ba363350543b2c9d Mon Sep 17 00:00:00 2001
From: Local ROM Builder <rombuilder@localhost>
Date: Wed, 7 Oct 2026 01:43:59 +0800
Subject: [PATCH] Migrate platform resource namespace preserving resource IDs
 and generated Java ABI

Change-Id: I1cbd2fbd7b5e28ab131a403edd7cac3124238c87
---
 Settings/res/xml/device_info_settings.xml        | 4 ++--
 Settings/res/xml/device_info_settings_vendor.xml | 4 ++--
 Settings/res/xml/device_info_settings_x.xml      | 4 ++--
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/Settings/res/xml/device_info_settings.xml b/Settings/res/xml/device_info_settings.xml
index c28759b..352b196 100644
--- a/Settings/res/xml/device_info_settings.xml
+++ b/Settings/res/xml/device_info_settings.xml
@@ -92,7 +92,7 @@
 
     <!-- LineageOS version -->
     <Preference android:key="lineage_version"
-        android:title="@*lineageos.platform:string/lineage_version"
+        android:title="@*org.system.platform:string/lineage_version"
         android:summary="@string/device_info_default"/>
 
     <!-- Device Baseband version -->
@@ -107,7 +107,7 @@
 
     <!-- Device Build date -->
     <Preference android:key="build_date"
-        android:title="@*lineageos.platform:string/build_date"
+        android:title="@*org.system.platform:string/build_date"
         android:summary="@string/device_info_default"/>
 
     <!-- Detailed build version -->
diff --git a/Settings/res/xml/device_info_settings_vendor.xml b/Settings/res/xml/device_info_settings_vendor.xml
index 454e7cc..e3de1c0 100644
--- a/Settings/res/xml/device_info_settings_vendor.xml
+++ b/Settings/res/xml/device_info_settings_vendor.xml
@@ -104,7 +104,7 @@
 
     <!-- LineageOS version -->
     <Preference android:key="lineage_version"
-        android:title="@*lineageos.platform:string/lineage_version"
