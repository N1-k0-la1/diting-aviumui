diff --git a/device.mk b/device.mk
index b803d30..8152aea 100644
--- a/device.mk
+++ b/device.mk
@@ -17,6 +17,18 @@ PRODUCT_COPY_FILES += \
     $(LOCAL_PATH)/audio/resourcemanager_waipio_mtp.xml:$(TARGET_COPY_OUT_VENDOR)/etc/audio/sku_cape/resourcemanager_waipio_mtp.xml \
     $(LOCAL_PATH)/audio/usecaseKvManager.xml:$(TARGET_COPY_OUT_VENDOR)/etc/usecaseKvManager.xml
 
+# Optional built-in eUICC support. Enable only on the verified eSIM variant.
+# Physical slot 1 was reported as eUICC on the target phone. Other variants
+# keep the baseline configuration unless explicitly opted in at build time.
+ifeq ($(TARGET_DITING_ESIM),true)
+PRODUCT_PACKAGES += \
+    OpenEUICC \
+    FrameworksResDitingEsim
+
+PRODUCT_COPY_FILES += \
+    frameworks/native/data/etc/android.hardware.telephony.euicc.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.telephony.euicc.xml
+endif
+
 # Overlay
 PRODUCT_PACKAGES += \
     ApertureResDiting \
